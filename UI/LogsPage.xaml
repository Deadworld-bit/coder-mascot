<UserControl x:Class="CoderMascot.UI.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:CoderMascot.UI"
             SizeChanged="OnPageSized">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Merged here rather than left to the main window: a control parses its
                 markup in its constructor, before it has a parent, so a StaticResource
                 that only the window's dictionary holds cannot be found yet. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A fixed height: the list holds up to fifty thousand of these, and a
                 row that can change size is a list that cannot scroll by item.
                 Selection is the left mark and a lifted fill, the way the nav says
                 which page you are on. -->
            <Style x:Key="LogItem" TargetType="ListBoxItem">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid>
                                <Border x:Name="Row" Background="Transparent"
                                        BorderBrush="{StaticResource Hair}" BorderThickness="0,0,0,1">
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>
                                <Border x:Name="Mark" Width="3" HorizontalAlignment="Left"
                                        Background="{StaticResource Pick}" Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Row}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Card}" />
                                    <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The scroller is named so the code can find it: after a refresh the
                 list is put back where it was by item, not by pixel. The system
                 style stays underneath on purpose: it is what makes the list one
                 stop in the tab order instead of one per row. -->
            <Style x:Key="LogList" TargetType="ListBox">
                <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource LogItem}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="Scroller" Focusable="False"
                                              CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Built for the rows on screen only; every value is read once, so no row
                 holds a listener and a recycled row costs a handful of property reads. -->
            <DataTemplate x:Key="LogRowTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{Binding Stripe, Mode=OneTime}" />

                    <TextBlock Grid.Column="1" Text="{Binding When, Mode=OneTime}"
                               Style="{StaticResource Figure}" Margin="10,0,0,0"
                               VerticalAlignment="Center" />

                    <Border Grid.Column="2" Width="36" Height="18" CornerRadius="4"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{Binding PillBack, Mode=OneTime}">
                        <TextBlock Text="{Binding Pill, Mode=OneTime}" FontFamily="{StaticResource FaceMono}"
                                   FontSize="{StaticResource TextLabel}" FontWeight="SemiBold"
                                   Foreground="{Binding PillInk, Mode=OneTime}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Grid.Column="3" Text="{Binding Preview, Mode=OneTime}"
                               Foreground="{Binding Ink, Mode=OneTime}"
                               FontSize="{StaticResource TextSmall}" TextTrimming="CharacterEllipsis"
                               Margin="4,0,12,0" VerticalAlignment="Center" />

                    <TextBlock Grid.Column="4" Text="{Binding File, Mode=OneTime}"
                               Foreground="{StaticResource Dim}" FontSize="{StaticResource TextLabel}"
                               MaxWidth="170" TextTrimming="CharacterEllipsis"
                               Margin="0,0,12,0" VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- ================= nothing configured ================= -->
        <StackPanel x:Name="NoSources" Visibility="Collapsed" MaxWidth="460"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
            <TextBlock Text="No log sources yet" Style="{StaticResource Title}"
                       HorizontalAlignment="Center" />
            <TextBlock Style="{StaticResource Prose}" TextAlignment="Center" Margin="0,8,0,0"
                       Text="Paste log files into a folder on this PC, or connect to a SQL Server or MongoDB log table, then add it here." />
            <Button Content="Add source" Style="{StaticResource Primary}"
                    HorizontalAlignment="Center" Margin="0,16,0,0" Click="OnAddSource" />
        </StackPanel>

        <Grid x:Name="Panes">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SourceColumn" Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= the sources ================= -->
            <Border Grid.Column="0" Background="{StaticResource Sunk}"
                    BorderBrush="{StaticResource Hair}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="8,8,8,8">
                        <TextBlock Text="LOG SOURCES" Style="{StaticResource SectionHead}"
                                   Margin="12,4,0,8" />
                        <Button Content="+ Add source" Click="OnAddSource" Style="{StaticResource Quiet}"
                                HorizontalAlignment="Stretch"
                                ToolTip="Read log files from a folder on this PC, or rows from a SQL Server table or MongoDB collection" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="5,3,5,16">
                        <!-- Room for the focus ring, which the scroller would otherwise clip. -->
                        <StackPanel Margin="3,0">
                            <ItemsControl x:Name="SourceList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource NavItem}" Height="Auto"
                                                Click="OnPickSource" ToolTip="{Binding Tip}">
                                            <Grid>
                                                <Border Width="3" HorizontalAlignment="Left" Margin="0,7"
                                                        CornerRadius="0,2,2,0" Background="{Binding Bar}" />

                                                <StackPanel Margin="16,8,10,8" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Path}" Style="{StaticResource Muted}"
                                                               FontFamily="{StaticResource FaceMono}"
                                                               FontSize="{StaticResource TextLabel}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding Sub}" Foreground="{Binding SubInk}"
                                                               FontSize="{StaticResource TextLabel}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ================= the folder's entries ================= -->
            <Grid Grid.Column="1" SizeChanged="OnRightSized">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- which one, and what you can do to it -->
                <Grid Grid.Row="0" Margin="24,16,24,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="HeadTitle" Style="{StaticResource Title}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="HeadDetail" Style="{StaticResource Muted}"
                                   FontFamily="{StaticResource FaceMono}" FontSize="{StaticResource TextLabel}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="HeadNote" Foreground="{StaticResource BadInk}"
                                   FontSize="{StaticResource TextSmall}" TextWrapping="Wrap"
                                   Margin="0,6,0,0" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                                Margin="{StaticResource GapBefore}">
                        <Button x:Name="BtnEdit" Content="Edit…" Click="OnEdit" Style="{StaticResource Quiet}"
                                Margin="{StaticResource GapButton}"
                                ToolTip="Change this folder, its name or which files are read" />
                        <Button x:Name="BtnOpen" Content="Open folder" Click="OnOpenFolder" Style="{StaticResource Quiet}"
                                Margin="{StaticResource GapButton}"
                                ToolTip="Show this folder in Windows Explorer" />
                        <Button x:Name="BtnReload" Content="Reload" Click="OnReload" Style="{StaticResource Quiet}"
                                ToolTip="Look at the folder again now, without waiting for the next sweep" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <!-- Stands in for everything below when there is nothing to list. -->
                    <Border x:Name="NoticeCard" Style="{StaticResource CardBorder}" Padding="22,20"
                            Margin="24,0,24,24" VerticalAlignment="Top" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="NoticeTitle" Style="{StaticResource Title}"
                                       FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock x:Name="NoticeText" Style="{StaticResource Prose}"
                                       MaxWidth="620" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Grid x:Name="Listing">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="3*" MinHeight="120" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="2*" MinHeight="110" />
                        </Grid.RowDefinitions>

                        <!-- The search drops to a line of its own on a narrow page. -->
                        <Grid x:Name="FilterBar" Grid.Row="0" Margin="24,0,24,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ComboBox x:Name="LevelBox" Grid.Row="0" Grid.Column="0" Width="160" Height="32"
                                      SelectionChanged="OnFilterChanged" AutomationProperties.Name="Level"
                                      ToolTip="Which levels to show">
                                <ComboBoxItem Content="All levels" />
                                <ComboBoxItem Content="Info and up" />
                                <ComboBoxItem Content="Warnings and errors" />
                                <ComboBoxItem Content="Errors only" />
                            </ComboBox>

                            <ComboBox x:Name="FileBox" Grid.Row="0" Grid.Column="1" Width="170" Height="32"
                                      Margin="{StaticResource GapBefore}"
                                      SelectionChanged="OnFileChanged" AutomationProperties.Name="File"
                                      ToolTip="Show one file's entries, or all of them" />

                            <TextBox x:Name="SearchBox" Grid.Row="0" Grid.Column="2" MinWidth="140"
                                     Margin="{StaticResource GapBefore}"
                                     ui:Field.Hint="Search messages and details  (Ctrl+F)"
                                     TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKey"
                                     AutomationProperties.Name="Search"
                                     ToolTip="Find text in an entry's message or its details  (Ctrl+F, Esc clears)" />

                            <Button x:Name="SortButton" Grid.Row="0" Grid.Column="3" Content="Newest first"
                                    Style="{StaticResource Quiet}" Height="32" MinWidth="104"
                                    Margin="{StaticResource GapBefore}" Click="OnSortFlip"
                                    AutomationProperties.Name="Sort order"
                                    ToolTip="Showing the newest entries first. Press to show the oldest first." />
                        </Grid>

                        <!-- the entries, and what could not be shown of them -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- A table whose last read failed: the entries below are older than this. -->
                            <TextBlock x:Name="StaleNote" Grid.Row="0" Foreground="{StaticResource WarnInk}"
                                       FontSize="{StaticResource TextSmall}" TextWrapping="Wrap"
                                       Margin="24,0,24,8" Visibility="Collapsed" />

                            <Border Grid.Row="1" Margin="24,0,24,0" Background="{StaticResource Rail}"
                                    BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <ListBox x:Name="EntryList" Style="{StaticResource LogList}"
                                             ItemTemplate="{StaticResource LogRowTemplate}"
                                             ScrollViewer.CanContentScroll="True"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             SelectionMode="Single" Margin="1"
                                             SelectionChanged="OnEntryPicked" KeyDown="OnListKey"
                                             AutomationProperties.Name="Log entries" />
                                    <TextBlock x:Name="NoMatch" Style="{StaticResource Muted}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextAlignment="Center" TextWrapping="Wrap" Margin="24"
                                               IsHitTestVisible="False" Visibility="Collapsed" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2" Margin="24,6,24,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="StatusLine" Style="{StaticResource Muted}"
                                               FontSize="{StaticResource TextLabel}" />
                                    <ItemsControl x:Name="NoteList" Margin="0,2,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="{StaticResource WarnInk}"
                                                           FontSize="{StaticResource TextLabel}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Only for a table, whose rows are read a page at a time. -->
                                <StackPanel x:Name="PagerBar" Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Top" Margin="12,0,0,0" Visibility="Collapsed">
                                    <Button x:Name="BtnNewest" Content="Newest" Click="OnPageNewest"
                                            Style="{StaticResource Quiet}" Height="32"
                                            Margin="{StaticResource GapButton}"
                                            AutomationProperties.Name="Newest page"
                                            ToolTip="Back to the newest rows" />
                                    <Button x:Name="BtnNewer" Content="&#x2039; Newer" Click="OnPageNewer"
                                            Style="{StaticResource Quiet}" Height="32"
                                            AutomationProperties.Name="Newer page"
                                            ToolTip="The page of newer rows" />
                                    <TextBlock x:Name="PageLabel" Style="{StaticResource Figure}" MinWidth="64"
                                               TextAlignment="Center" VerticalAlignment="Center" Margin="8,0" />
                                    <Button x:Name="BtnOlder" Content="Older &#x203A;" Click="OnPageOlder"
                                            Style="{StaticResource Quiet}" Height="32"
                                            AutomationProperties.Name="Older page"
                                            ToolTip="The page of older rows" />
                                    <ComboBox x:Name="PageSizeBox" Width="124" Height="32"
                                              Margin="{StaticResource GapBefore}"
                                              SelectionChanged="OnPageSizeChanged"
                                              AutomationProperties.Name="Rows per page"
                                              ToolTip="How many rows one page holds">
                                        <ComboBoxItem Content="50 per page" />
                                        <ComboBoxItem Content="100 per page" />
                                        <ComboBoxItem Content="200 per page" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center" ResizeDirection="Rows"
                                      ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                                      Background="Transparent" />

                        <!-- ===== the entry, whole ===== -->
                        <Border Grid.Row="3" Background="{StaticResource Rail}"
                                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                            <Grid>
                                <TextBlock x:Name="DetailEmpty" Style="{StaticResource Muted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Text="Select an entry to read it in full." />

                                <Grid x:Name="DetailBody" Margin="24,12,24,16" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="DetailPill" Grid.Column="0" CornerRadius="4" Height="18"
                                                Padding="8,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="DetailLevel" FontFamily="{StaticResource FaceMono}"
                                                       FontSize="{StaticResource TextLabel}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock x:Name="DetailTime" Grid.Column="1" Style="{StaticResource Figure}"
                                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DetailSource" Grid.Column="2" Style="{StaticResource Figure}"
                                                   Foreground="{StaticResource Dim}" Margin="12,0,12,0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button x:Name="BtnCopy" Grid.Column="3" Content="Copy" Click="OnCopy"
                                                Style="{StaticResource Quiet}"
                                                ToolTip="Put this entry on the clipboard  (Ctrl+C in the list)" />
                                    </Grid>

                                    <StackPanel Grid.Row="1">
                                        <TextBlock x:Name="CutNote" Foreground="{StaticResource WarnInk}"
                                                   FontSize="{StaticResource TextSmall}" TextWrapping="Wrap"
                                                   Margin="0,0,0,8" Visibility="Collapsed"
                                                   Text="This entry was cut at the size limit." />
                                        <TextBlock x:Name="CopyNote" FontSize="{StaticResource TextSmall}"
                                                   TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
                                    </StackPanel>

                                    <TextBox x:Name="DetailText" Grid.Row="2" IsReadOnly="True"
                                             IsReadOnlyCaretVisible="True" AcceptsReturn="True"
                                             TextWrapping="NoWrap" VerticalContentAlignment="Top"
                                             FontFamily="{StaticResource FaceMono}"
                                             FontSize="{StaticResource TextSmall}"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="Entry text" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
