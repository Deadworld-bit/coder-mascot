<UserControl x:Class="CoderMascot.UI.ProjectsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:CoderMascot.UI"
             SizeChanged="OnPageSized">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Merged here rather than left to the main window: a control parses its
                 markup in its constructor, before it has a parent, so a StaticResource
                 that only the window's dictionary holds cannot be found yet. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A count you can press. The number says how much there is; the
                 press is what most people wanted to do with it anyway. -->
            <DataTemplate x:Key="ChipTemplate">
            <Button Click="OnPickChip" Cursor="Hand" Margin="0,0,8,8"
                    Background="{Binding Back}" BorderBrush="{Binding Edge}"
                    BorderThickness="1" Padding="10,4" ToolTip="{Binding Tip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Count}" FontFamily="Consolas" FontSize="12"
                               FontWeight="SemiBold" Foreground="{Binding Ink}"
                               Margin="{StaticResource GapButton}" />
                    <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{Binding Ink}" />
                </StackPanel>
            </Button>
            </DataTemplate>

            <!-- Unseen until its row is pointed at, focused or traced. Opacity and not
                 Visibility, so it keeps its place in the row and in the tab order. The
                 starting value is a style setter, which every trigger in the row
                 template outranks. -->
            <Style x:Key="FadedQuiet" TargetType="Button" BasedOn="{StaticResource Quiet}">
                <Setter Property="Opacity" Value="0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RepoColumn" Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= repositories ================= -->
        <Border Grid.Column="0" Background="{StaticResource Sunk}"
                BorderBrush="{StaticResource Hair}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="8,8,8,8">
                    <Grid Margin="{StaticResource GapBelow}">
                        <TextBlock Text="REPOSITORIES" Style="{StaticResource SectionHead}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                        <Button Content="+ Add" Click="OnAddProject" Style="{StaticResource Quiet}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                ToolTip="Watch another repository" />
                    </Grid>

                    <TextBox x:Name="RepoSearch" ui:Field.Hint="Search repositories"
                             TextChanged="OnRepoSearchChanged"
                             ToolTip="Search by repository name, group or folder  (Esc clears)" />
                </StackPanel>

                <TextBlock x:Name="NoProjects" DockPanel.Dock="Bottom" Style="{StaticResource Muted}"
                           Margin="20,8,20,16" TextWrapping="Wrap" Visibility="Collapsed"
                           Text="Nothing here yet. Use + Add above." />

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="5,3,5,16">
                    <!-- Room for the focus ring, which the scroller would otherwise clip. -->
                    <StackPanel Margin="3,0">
                        <TextBlock x:Name="NoMatch" Style="{StaticResource Muted}"
                                   Margin="12,2,12,0" TextWrapping="Wrap" Visibility="Collapsed" />

                        <!-- Headings and repositories in one list, each drawn by
                             its own type. No ItemTemplate is set, which is what
                             lets the implicit templates below apply. -->
                        <ItemsControl x:Name="ProjectList">
                            <ItemsControl.Resources>

                                <DataTemplate DataType="{x:Type ui:GroupBar}">
                                    <Button Style="{StaticResource NavItem}" Click="OnToggleGroup"
                                            ToolTip="{Binding Tip}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- The selected repository is inside a group
                                                 that is folded shut: the mark comes up to
                                                 the heading so "where am I" still has an
                                                 answer on screen. -->
                                            <Border Grid.ColumnSpan="4" Width="3" HorizontalAlignment="Left"
                                                    Margin="0,7" CornerRadius="0,2,2,0"
                                                    Background="{Binding Bar}" />

                                            <!-- Drawn, not typed: a triangle is the same
                                                 shape in every font, and the last thing this
                                                 page needs is one more character that
                                                 renders as a box. Two fixed shapes rather
                                                 than one rotated one, because a binding on a
                                                 RenderTransform is the sort of thing that
                                                 works everywhere except where it doesn't. -->
                                            <Grid Grid.Column="0" Width="8" Height="8"
                                                  Margin="13,0,0,0" VerticalAlignment="Center">
                                                <Path Data="M 1,0 L 6,4 L 1,8 Z" Fill="{Binding Ink}"
                                                      Visibility="{Binding ShutShown}" />
                                                <Path Data="M 0,1 L 8,1 L 4,6 Z" Fill="{Binding Ink}"
                                                      Visibility="{Binding OpenShown}" />
                                            </Grid>

                                            <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                       Foreground="{Binding Ink}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="6,0,8,0" />

                                            <TextBlock Grid.Column="2" Text="{Binding Count}"
                                                       Style="{StaticResource Figure}"
                                                       Visibility="{Binding CountShown}"
                                                       VerticalAlignment="Center" Margin="{StaticResource GapAfter}" />

                                            <!-- Kept on the heading whether it is open or
                                                 shut. Folding a group away must not fold
                                                 away the reason to look in it. -->
                                            <Border Grid.Column="3" Height="18" MinWidth="22" CornerRadius="9"
                                                    Margin="0,0,10,0" VerticalAlignment="Center"
                                                    Background="{Binding BadgeBack}"
                                                    Visibility="{Binding BadgeShown}">
                                                <TextBlock Text="{Binding Badge}" FontSize="{StaticResource TextLabel}"
                                                           Foreground="{Binding BadgeInk}" Margin="6,0"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>

                                <DataTemplate DataType="{x:Type ui:ProjectRow}">
                                    <Button Style="{StaticResource NavItem}" Height="Auto"
                                            Click="OnPickProject" ToolTip="{Binding Tip}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Which row is selected, said with position
                                                 and not only with a slightly lighter fill. -->
                                            <Border Grid.ColumnSpan="2" Width="3" HorizontalAlignment="Left"
                                                    Margin="0,7" CornerRadius="0,2,2,0"
                                                    Background="{Binding Bar}" />

                                            <StackPanel Grid.Column="0" Margin="{Binding Indent}"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Sub}" Style="{StaticResource Muted}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <Border Grid.Column="1" Height="18" MinWidth="22" CornerRadius="9"
                                                    Margin="8,0,10,0" VerticalAlignment="Center"
                                                    Background="{Binding BadgeBack}"
                                                    Visibility="{Binding BadgeShown}">
                                                <TextBlock Text="{Binding Badge}" FontSize="{StaticResource TextLabel}"
                                                           Foreground="{Binding BadgeInk}" Margin="6,0"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>

                            </ItemsControl.Resources>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================= the repository ================= -->
        <Grid Grid.Column="1" SizeChanged="OnRightSized">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- which one, and what you can do to it -->
            <Grid Grid.Row="0" Margin="24,16,24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeadTitle" Text="Branches" Style="{StaticResource Title}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="HeadDetail" Style="{StaticResource Muted}" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="{StaticResource GapBefore}">
                    <TextBlock x:Name="BusyNote" Style="{StaticResource Muted}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button x:Name="BtnEdit" Content="Edit…" Click="OnEditProject" Style="{StaticResource Quiet}"
                            Margin="{StaticResource GapButton}"
                            ToolTip="Change this repository's folder, name or deploy branches" />
                    <Button x:Name="BtnRead" Content="Re-read" Click="OnReRead" Style="{StaticResource Quiet}"
                            Margin="{StaticResource GapButton}"
                            ToolTip="Read the repository again, without touching the network  (F5)" />
                    <Button x:Name="BtnFetch" Content="Fetch from origin" Click="OnFetch" Style="{StaticResource Quiet}"
                            ToolTip="git fetch --all --prune, then re-read. For a repository added by URL, this is also what downloads it the first time." />
                </StackPanel>
            </Grid>

            <!-- Anything wrong sits at the top and stays there: a warning you
                 have to scroll to find is a warning nobody reads. -->
            <StackPanel Grid.Row="1" Margin="24,0,24,0">
                <Border x:Name="EmptyCard" Style="{StaticResource CardBorder}" Padding="22,20"
                        Visibility="Collapsed" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Nothing is being watched yet" Style="{StaticResource Title}"
                                   FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                   MaxWidth="620" HorizontalAlignment="Left" Margin="0,8,0,0"
                                   Text="Add the repositories you ship from &#x2014; straight from a git URL, a clone inside the workspace, or a folder on this PC. For each one, name the branches your CI deploys from: every other branch is then measured against those, which is how this page answers &quot;is my work live yet?&quot;." />
                        <Button Content="Add a repository" Style="{StaticResource Primary}"
                                HorizontalAlignment="Left" Margin="0,16,0,0" Click="OnAddProject" />
                    </StackPanel>
                </Border>

                <Border x:Name="ProblemCard" Style="{StaticResource CardBorder}"
                        Background="{StaticResource BadTint}" BorderBrush="{StaticResource BadEdge}" Visibility="Collapsed"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Couldn't read this repository" FontWeight="SemiBold" />
                        <TextBlock x:Name="ProblemText" Style="{StaticResource Muted}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Something went wrong that did not invalidate the reading —
                     the cards below are still true, so they stay. -->
                <Border x:Name="WarningCard" Style="{StaticResource CardBorder}"
                        Background="{StaticResource WarnTint}" BorderBrush="{StaticResource WarnEdge}" Visibility="Collapsed"
                        Margin="0,0,0,12">
                    <TextBlock x:Name="WarningText" TextWrapping="Wrap" Foreground="{StaticResource WarnInk}" />
                </Border>
            </StackPanel>

            <!-- What is live and what is linked, in one band: the reference everything
                 below is measured against, so it stays on screen rather than
                 scrolling away with the list. Side by side when there is room; the
                 code moves Diagrams under Deployed when there is not. -->
            <Border x:Name="Band" Grid.Row="2" Visibility="Collapsed"
                    Background="{StaticResource Head}" BorderBrush="{StaticResource Hair}"
                    BorderThickness="0,1,0,1" Padding="24,12,24,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="DeployedStrip" Grid.Row="0" Grid.Column="0">
                        <!-- As tall as the Diagrams heading, which carries a button, so the
                             two headings sit on one line. -->
                        <Grid MinHeight="26" Margin="0,0,0,6">
                            <TextBlock Text="DEPLOYED" Style="{StaticResource SectionHead}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <ItemsControl x:Name="TargetList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
                                            BorderThickness="1" CornerRadius="8" Margin="0,0,8,8"
                                            Padding="0" MinWidth="230" ToolTip="{Binding Last}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Background="{Binding Accent}"
                                                    CornerRadius="8,0,0,8" />

                                            <StackPanel Grid.Column="1" Margin="12,8,12,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Environment}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Branch}"
                                                               Style="{StaticResource Figure}"
                                                               Margin="{StaticResource GapBefore}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Last}" Style="{StaticResource Muted}"
                                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border x:Name="BandDivider" Grid.Row="0" Grid.Column="1" Width="1" Margin="16,0,16,8"
                            Background="{StaticResource Hair}" />

                    <!-- Kept to a width a row of chips can wrap inside: left to size
                         itself it would run off the side of the page in one line. -->
                    <StackPanel x:Name="DiagramStrip" Grid.Row="0" Grid.Column="2"
                                HorizontalAlignment="Left" MinWidth="220" MaxWidth="360">
                        <Grid MinHeight="26" Margin="0,0,0,6">
                            <TextBlock Text="DIAGRAMS" Style="{StaticResource SectionHead}"
                                       VerticalAlignment="Center" />
                            <Button Content="+ Add" Click="OnAddDiagram" Style="{StaticResource Quiet}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    ToolTip="Link a draw.io file on this PC, or a web page that shows one" />
                        </Grid>

                        <TextBlock x:Name="DiagramsEmpty" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                   Visibility="Collapsed" Margin="0,0,0,8" />

                        <ItemsControl x:Name="DiagramList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="OnOpenDiagram" Cursor="Hand" Margin="0,0,8,8"
                                            Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
                                            BorderThickness="1" Padding="12,6" ToolTip="{Binding Tip}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Open" Click="OnOpenDiagram" />
                                                <MenuItem Header="Edit…" Click="OnEditDiagram" />
                                                <Separator />
                                                <MenuItem Header="Remove" Click="OnRemoveDiagram" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" MaxWidth="260"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Kind}" Style="{StaticResource Muted}"
                                                       FontSize="{StaticResource TextLabel}"
                                                       Margin="{StaticResource GapBefore}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="DiagramNote" Foreground="{StaticResource WarnInk}" TextWrapping="Wrap"
                                   Visibility="Collapsed" Margin="0,0,0,8" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Pinned. Scrolling forty branches must not take the box that filters
                 them off the screen. The sort, the filter and the timeline switch sit
                 at the right on a wide page and drop to a line of their own on a
                 narrow one. -->
            <Grid Grid.Row="3" Margin="24,12,24,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="BRANCHES" Style="{StaticResource SectionHead}"
                           VerticalAlignment="Center" />

                <StackPanel x:Name="ToolbarTools" Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="sort" Style="{StaticResource Muted}"
                               VerticalAlignment="Center" Margin="{StaticResource GapButton}" />
                    <ComboBox x:Name="SortBox" Width="140"
                              SelectionChanged="OnSortChanged">
                        <ComboBoxItem Content="Recently touched" />
                        <ComboBoxItem Content="Name" />
                        <ComboBoxItem Content="Furthest behind" />
                        <ComboBoxItem Content="Author" />
                    </ComboBox>
                    <TextBox x:Name="BranchFilter" Width="200" Margin="{StaticResource GapBefore}"
                             ui:Field.Hint="Filter branches  (Ctrl+F)"
                             TextChanged="OnFilterChanged"
                             ToolTip="Filter by branch name, author, or commit subject  (Ctrl+F, Esc clears)" />
                    <CheckBox x:Name="TimelineToggle" Style="{StaticResource Switch}" Content="Timeline"
                              IsChecked="True" Click="OnTimelineToggle"
                              VerticalAlignment="Center" Margin="16,0,0,0"
                              ToolTip="Show what landed in each deploy branch, and when, beside the list" />
                </StackPanel>

                <!-- The counts, and the filters, as one thing. Reading
                     "12 not shipped" and then hunting for the control
                     that shows you those twelve is two steps where there
                     is no reason for two. -->
                <ItemsControl x:Name="SummaryChips" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                              Margin="0,8,0,0"
                              ItemTemplate="{StaticResource ChipTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>

            <!-- Branches and the timeline side by side, each scrolling on its
                 own. Stacked, the timeline sat forty rows below the branch it
                 explained, which is the one place you actually want them
                 together: "has this shipped" and "when did it ship". -->
            <Grid Grid.Row="4" SizeChanged="OnSplitSized">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="BranchesColumn" Width="*" MinWidth="340" />
                    <ColumnDefinition x:Name="SplitColumn" Width="6" />
                    <ColumnDefinition x:Name="TimelineColumn" Width="360" MinWidth="260" />
                </Grid.ColumnDefinitions>

                <!-- ===== branches ===== -->
                <ScrollViewer Grid.Column="0" Margin="24,0,0,0" VerticalScrollBarVisibility="Auto"
                              Padding="0,0,12,16">
                    <StackPanel>
                        <TextBlock x:Name="BranchesEmpty" Style="{StaticResource Muted}"
                                   Margin="0,6,0,10" TextWrapping="Wrap" Visibility="Collapsed" />

                        <!-- Two kinds of row in one list: the group heading
                             and the branch. Implicit templates by type, so
                             neither has to know about the other. -->
                        <ItemsControl x:Name="BranchList">
                            <ItemsControl.Resources>
                                <DataTemplate DataType="{x:Type ui:GroupHeader}">
                                    <Grid Margin="0,16,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{Binding Accent}" Width="7" Height="7"
                                                    CornerRadius="3.5" VerticalAlignment="Center"
                                                    Margin="{StaticResource GapAfter}" />
                                            <TextBlock Text="{Binding Title}"
                                                       Style="{StaticResource SectionHead}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Count}"
                                                       Style="{StaticResource Figure}"
                                                       FontSize="11" Margin="{StaticResource GapBefore}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}"
                                                   HorizontalAlignment="Right" FontSize="11"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>

                                <DataTemplate DataType="{x:Type ui:BranchRow}">
                                    <Border x:Name="RowBorder" Background="{Binding Back}"
                                            BorderThickness="1" CornerRadius="8" Margin="0,0,0,5"
                                            Padding="0">
                                        <Border.Style>
                                            <!-- In the style, not on the element, or the hover trigger can never win. -->
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Background="{Binding Accent}"
                                                    CornerRadius="8,0,0,8" />

                                            <StackPanel Grid.Column="1" Margin="12,8,10,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               FontFamily="Consolas" FontSize="13"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Name}" />
                                                    <Border Background="{StaticResource DeployTint}" CornerRadius="5" Padding="6,1"
                                                            Margin="6,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding TargetShown}">
                                                        <TextBlock Text="{Binding TargetLabel}" FontSize="11"
                                                                   Foreground="{StaticResource DeployInk}" />
                                                    </Border>
                                                    <Border Background="{StaticResource PartlyTint}" CornerRadius="5" Padding="6,1"
                                                            Margin="6,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding SideShown}">
                                                        <TextBlock Text="{Binding SideLabel}" FontSize="11"
                                                                   Foreground="{StaticResource PartlyInk}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Sub}" Style="{StaticResource Muted}"
                                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Sub}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding Counts}"
                                                       Style="{StaticResource Figure}"
                                                       VerticalAlignment="Center" Margin="6,0,10,0"
                                                       ToolTip="{Binding CountsTip}" />

                                            <ItemsControl Grid.Column="3" ItemsSource="{Binding Pills}"
                                                          VerticalAlignment="Center" Margin="{StaticResource GapButton}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding Back}" CornerRadius="10"
                                                                Padding="9,3" Margin="{StaticResource GapButton}"
                                                                ToolTip="{Binding Tip}">
                                                            <TextBlock Text="{Binding Text}" FontSize="11"
                                                                       Foreground="{Binding Ink}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Button x:Name="TraceButton" Grid.Column="4" Content="Trace" Click="OnTraceBranch"
                                                    Style="{StaticResource FadedQuiet}"
                                                    VerticalAlignment="Center" Margin="0,0,10,0"
                                                    ToolTip="Show only this branch in the timeline" />
                                        </Grid>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="RowBorder" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TraceButton" Property="Opacity" Value="1" />
                                        </Trigger>
                                        <Trigger SourceName="RowBorder" Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="TraceButton" Property="Opacity" Value="1" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding Traced.On}" Value="True">
                                            <Setter TargetName="TraceButton" Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.Resources>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <GridSplitter x:Name="Splitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                              Background="Transparent" ResizeBehavior="PreviousAndNext"
                              ShowsPreview="False" />

                <!-- ===== timeline ===== -->
                <Border x:Name="TimelinePane" Grid.Column="2" Background="{StaticResource Rail}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                    <DockPanel Margin="16,0,0,0">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,16,8">
                            <Grid Margin="{StaticResource GapBelow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="WHAT LANDED, AND WHEN"
                                           Style="{StaticResource SectionHead}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <ComboBox x:Name="TimelineTarget" Grid.Column="1" Width="140"
                                          Margin="{StaticResource GapBefore}"
                                          SelectionChanged="OnTimelineTargetChanged" />
                            </Grid>

                            <StackPanel x:Name="TracePanel" Orientation="Horizontal"
                                        Visibility="Collapsed">
                                <Border Background="{StaticResource PartlyTint}" CornerRadius="10" Padding="9,3">
                                    <TextBlock x:Name="TraceNote" FontSize="11" Foreground="{StaticResource PartlyInk}" />
                                </Border>
                                <Button x:Name="BtnClearTrace" Content="Show all" Click="OnClearTrace"
                                        Style="{StaticResource Quiet}" Margin="{StaticResource GapBefore}" />
                            </StackPanel>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,16,16">
                            <StackPanel>
                                <TextBlock x:Name="TimelineEmpty" Style="{StaticResource Muted}"
                                           Margin="0,4,0,10" TextWrapping="Wrap"
                                           Visibility="Collapsed" />

                                <ItemsControl x:Name="Timeline">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <!-- The day, once, as a band across the
                                                     column rather than a note in a gutter
                                                     that is no longer wide enough for it. -->
                                                <TextBlock Text="{Binding Day}"
                                                           Visibility="{Binding DayShown}"
                                                           Style="{StaticResource SectionHead}"
                                                           Margin="0,10,0,6" />

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- the spine: one line, a dot per landing -->
                                                    <Grid Grid.Column="0">
                                                        <Border Width="2" Background="{StaticResource Line}"
                                                                HorizontalAlignment="Center" />
                                                        <Ellipse Width="9" Height="9" Fill="{Binding Accent}"
                                                                 Stroke="{StaticResource Rail}" StrokeThickness="2"
                                                                 VerticalAlignment="Top"
                                                                 HorizontalAlignment="Center"
                                                                 Margin="0,12,0,0" />
                                                    </Grid>

                                                    <Border Grid.Column="1" Margin="6,5,0,5" Padding="11,8"
                                                            Background="{StaticResource Card}"
                                                            BorderBrush="{StaticResource Line}"
                                                            BorderThickness="1"
                                                            CornerRadius="8" Opacity="{Binding Fade}">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Source}"
                                                                           FontFamily="Consolas"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Source}" />
                                                                <TextBlock Text="{Binding When}"
                                                                           Style="{StaticResource Figure}"
                                                                           Margin="10,0,0,0" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Detail}"
                                                                       Style="{StaticResource Muted}"
                                                                       Margin="0,3,0,0"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Detail}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
