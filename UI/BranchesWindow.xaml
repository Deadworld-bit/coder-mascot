<Window x:Class="CoderMascot.UI.BranchesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CoderMascot.UI"
        Title="Branches"
        Width="1280" Height="820"
        MinWidth="980" MinHeight="560"
        Background="{StaticResource Page}"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Counts and times line up in columns, so they get tabular figures. -->
        <Style x:Key="Figure" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="SectionHead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="{StaticResource Line}" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Edge}" />
                            </Trigger>
                            <!-- Keyboard users need to see where they are, and the
                                 default WPF dotted rectangle is invisible on this
                                 background. -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Pick}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Pick}" />
            <Setter Property="BorderBrush" Value="{StaticResource Pick}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Background" Value="{StaticResource Well}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <!-- A count you can press. The number tells you how much there is; the
             press is what most people wanted to do with it anyway. -->
        <DataTemplate x:Key="ChipTemplate">
            <Button Click="OnPickChip" Cursor="Hand" Margin="0,0,8,8"
                    Background="{Binding Back}" BorderBrush="{Binding Edge}"
                    BorderThickness="1" Padding="10,4" ToolTip="{Binding Tip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Count}" FontFamily="Consolas" FontSize="12"
                               FontWeight="SemiBold" Foreground="{Binding Ink}"
                               Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Text}" FontSize="11.5" Foreground="{Binding Ink}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Head}" Padding="18,12"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeadTitle" Text="Branches" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeadDetail" Style="{StaticResource Muted}" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="BusyNote" Style="{StaticResource Muted}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button x:Name="BtnEdit" Content="Edit…" Click="OnEditProject" Margin="0,0,6,0"
                            ToolTip="Change this repository's folder, name or deploy branches" />
                    <Button x:Name="BtnRead" Content="Re-read" Click="OnReRead" Margin="0,0,6,0"
                            ToolTip="Read the repository again, without touching the network  (F5)" />
                    <Button x:Name="BtnFetch" Content="Fetch from origin" Click="OnFetch"
                            ToolTip="git fetch --all --prune, then re-read. For a repository added by URL, this is also what downloads it the first time." />
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- projects rail -->
            <Border Grid.Column="0" Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="16,14,12,10">
                        <TextBlock Text="PROJECTS" Style="{StaticResource SectionHead}"
                                   VerticalAlignment="Center" />
                        <Button Content="+ Add" Click="OnAddProject" Style="{StaticResource Quiet}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                ToolTip="Watch another repository" />
                    </Grid>

                    <TextBlock x:Name="NoProjects" DockPanel.Dock="Bottom" Style="{StaticResource Muted}"
                               Margin="16,8,16,16" TextWrapping="Wrap" Visibility="Collapsed"
                               Text="Nothing here yet. Use + Add above." />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <!-- Headings and repositories in one list, each drawn by
                             its own type. No ItemTemplate is set, which is what
                             lets the implicit templates below apply. -->
                        <ItemsControl x:Name="ProjectList">
                            <ItemsControl.Resources>

                                <DataTemplate DataType="{x:Type ui:GroupBar}">
                                    <Button Click="OnToggleGroup" Cursor="Hand"
                                            HorizontalContentAlignment="Stretch"
                                            Background="{StaticResource Sunk}" BorderBrush="{StaticResource Hair}"
                                            BorderThickness="0,0,0,1" Padding="0" Margin="0"
                                            ToolTip="{Binding Tip}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- The selected repository is inside a group
                                                 that is folded shut: the mark comes up to
                                                 the heading so "where am I" still has an
                                                 answer on screen. -->
                                            <Border Grid.Column="0" Background="{Binding Mark}" />

                                            <!-- Drawn, not typed: a triangle is the same
                                                 shape in every font, and the last thing this
                                                 window needs is one more character that
                                                 renders as a box. Two fixed shapes rather
                                                 than one rotated one, because a binding on a
                                                 RenderTransform is the sort of thing that
                                                 works everywhere except where it doesn't. -->
                                            <Grid Grid.Column="1" Width="8" Height="8"
                                                  Margin="13,0,0,0" VerticalAlignment="Center">
                                                <Path Data="M 1,0 L 6,4 L 1,8 Z" Fill="{Binding Ink}"
                                                      Visibility="{Binding ShutShown}" />
                                                <Path Data="M 0,1 L 8,1 L 4,6 Z" Fill="{Binding Ink}"
                                                      Visibility="{Binding OpenShown}" />
                                            </Grid>

                                            <TextBlock Grid.Column="2" Text="{Binding Title}"
                                                       Foreground="{Binding Ink}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="6,10,8,10" />

                                            <TextBlock Grid.Column="3" Text="{Binding Count}"
                                                       Style="{StaticResource Figure}"
                                                       Visibility="{Binding CountShown}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />

                                            <!-- Kept on the heading whether it is open or
                                                 shut. Folding a group away must not fold
                                                 away the reason to look in it. -->
                                            <Border Grid.Column="4" VerticalAlignment="Center"
                                                    Background="{Binding BadgeBack}" CornerRadius="10"
                                                    Padding="7,2" Margin="0,0,16,0"
                                                    Visibility="{Binding BadgeShown}">
                                                <TextBlock Text="{Binding Badge}" FontSize="11"
                                                           Foreground="{Binding BadgeInk}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>

                                <DataTemplate DataType="{x:Type ui:ProjectRow}">
                                    <Button Click="OnPickProject" Cursor="Hand"
                                            HorizontalContentAlignment="Stretch"
                                            Background="{Binding Back}" BorderBrush="{Binding Edge}"
                                            BorderThickness="0,0,0,1" Padding="0" Margin="0"
                                            ToolTip="{Binding Tip}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Which row is selected, said with position
                                                 and not only with a slightly lighter fill. -->
                                            <Border Grid.Column="0" Background="{Binding Mark}" />

                                            <StackPanel Grid.Column="1" Margin="{Binding Indent}">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Sub}" Style="{StaticResource Muted}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <Border Grid.Column="2" VerticalAlignment="Center"
                                                    Background="{Binding BadgeBack}" CornerRadius="10"
                                                    Padding="7,2" Margin="8,0,16,0"
                                                    Visibility="{Binding BadgeShown}">
                                                <TextBlock Text="{Binding Badge}" FontSize="11"
                                                           Foreground="{Binding BadgeInk}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>

                            </ItemsControl.Resources>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- the repository -->
            <DockPanel Grid.Column="1" Margin="0">

                <!-- Anything wrong sits at the top and stays there: a warning you
                     have to scroll to find is a warning nobody reads. -->
                <StackPanel DockPanel.Dock="Top" Margin="18,14,18,0">
                    <Border x:Name="EmptyCard" Style="{StaticResource CardBorder}" Padding="22,20"
                            Visibility="Collapsed" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Nothing is being watched yet" FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                       MaxWidth="620" HorizontalAlignment="Left" Margin="0,8,0,0"
                                       Text="Add the repositories you ship from &#x2014; straight from a git URL, a clone inside the workspace, or a folder on this PC. For each one, name the branches your CI deploys from: every other branch is then measured against those, which is how this window answers &quot;is my work live yet?&quot;." />
                            <Button Content="Add a repository" Style="{StaticResource Primary}"
                                    HorizontalAlignment="Left" Margin="0,16,0,0" Click="OnAddProject" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="ProblemCard" Style="{StaticResource CardBorder}"
                            Background="{StaticResource BadTint}" BorderBrush="{StaticResource BadEdge}" Visibility="Collapsed"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Couldn't read this repository" FontWeight="SemiBold" />
                            <TextBlock x:Name="ProblemText" Style="{StaticResource Muted}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Something went wrong that did not invalidate the reading —
                         the cards below are still true, so they stay. -->
                    <Border x:Name="WarningCard" Style="{StaticResource CardBorder}"
                            Background="{StaticResource WarnTint}" BorderBrush="{StaticResource WarnEdge}" Visibility="Collapsed"
                            Margin="0,0,0,12">
                        <TextBlock x:Name="WarningText" TextWrapping="Wrap" Foreground="{StaticResource WarnInk}" />
                    </Border>
                </StackPanel>

                <!-- what is live: the reference everything below is measured against,
                     so it stays on screen rather than scrolling away with the list -->
                <StackPanel DockPanel.Dock="Top" x:Name="DeployedStrip" Margin="18,0,18,0">
                    <TextBlock Text="DEPLOYED" Style="{StaticResource SectionHead}" Margin="0,4,0,8" />
                    <ItemsControl x:Name="TargetList" Margin="0,0,0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
                                        BorderThickness="1" CornerRadius="8" Margin="0,0,8,8"
                                        Padding="0" MinWidth="230" ToolTip="{Binding Last}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{Binding Accent}"
                                                CornerRadius="8,0,0,8" />

                                        <StackPanel Grid.Column="1" Margin="12,8,12,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Environment}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Branch}"
                                                           Style="{StaticResource Figure}"
                                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Last}" Style="{StaticResource Muted}"
                                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Branches and the timeline side by side, each scrolling on its
                     own. Stacked, the timeline sat forty rows below the branch it
                     explained, which is the one place you actually want them
                     together: "has this shipped" and "when did it ship". -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="400" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="400" MinWidth="300" />
                    </Grid.ColumnDefinitions>

                    <!-- ===== branches ===== -->
                    <DockPanel Grid.Column="0" Margin="18,0,0,0">

                        <!-- Pinned. Scrolling forty branches must not take the box
                             that filters them off the screen. -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,12,8">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="BRANCHES" Style="{StaticResource SectionHead}"
                                           VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="sort" Style="{StaticResource Muted}"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox x:Name="SortBox" Width="150"
                                              SelectionChanged="OnSortChanged">
                                        <ComboBoxItem Content="Recently touched" />
                                        <ComboBoxItem Content="Name" />
                                        <ComboBoxItem Content="Furthest behind" />
                                        <ComboBoxItem Content="Author" />
                                    </ComboBox>
                                    <TextBox x:Name="BranchFilter" Width="200" Margin="8,0,0,0"
                                             TextChanged="OnFilterChanged"
                                             ToolTip="Filter by branch name, author, or commit subject  (Ctrl+F, Esc clears)" />
                                </StackPanel>
                            </Grid>

                            <!-- The counts, and the filters, as one thing. Reading
                                 "12 not shipped" and then hunting for the control
                                 that shows you those twelve is two steps where
                                 there is no reason for two. -->
                            <ItemsControl x:Name="SummaryChips"
                                          ItemTemplate="{StaticResource ChipTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,16">
                            <StackPanel>
                                <TextBlock x:Name="BranchesEmpty" Style="{StaticResource Muted}"
                                           Margin="0,6,0,10" TextWrapping="Wrap" Visibility="Collapsed" />

                                <!-- Two kinds of row in one list: the group heading
                                     and the branch. Implicit templates by type, so
                                     neither has to know about the other. -->
                                <ItemsControl x:Name="BranchList">
                                    <ItemsControl.Resources>
                                        <DataTemplate DataType="{x:Type ui:GroupHeader}">
                                            <Grid Margin="0,16,0,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="{Binding Accent}" Width="7" Height="7"
                                                            CornerRadius="3.5" VerticalAlignment="Center"
                                                            Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Title}"
                                                               Style="{StaticResource SectionHead}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Count}"
                                                               Style="{StaticResource Figure}"
                                                               FontSize="11" Margin="8,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}"
                                                           HorizontalAlignment="Right" FontSize="11"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>

                                        <DataTemplate DataType="{x:Type ui:BranchRow}">
                                            <Border Background="{Binding Back}"
                                                    BorderBrush="{StaticResource Line}"
                                                    BorderThickness="1" CornerRadius="8" Margin="0,0,0,5"
                                                    Padding="0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Background="{Binding Accent}"
                                                            CornerRadius="8,0,0,8" />

                                                    <StackPanel Grid.Column="1" Margin="12,8,10,8">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                       FontFamily="Consolas" FontSize="13"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Name}" />
                                                            <Border Background="{StaticResource DeployTint}" CornerRadius="5" Padding="6,1"
                                                                    Margin="6,0,0,0" VerticalAlignment="Center"
                                                                    Visibility="{Binding TargetShown}">
                                                                <TextBlock Text="{Binding TargetLabel}" FontSize="11"
                                                                           Foreground="{StaticResource DeployInk}" />
                                                            </Border>
                                                            <Border Background="{StaticResource PartlyTint}" CornerRadius="5" Padding="6,1"
                                                                    Margin="6,0,0,0" VerticalAlignment="Center"
                                                                    Visibility="{Binding SideShown}">
                                                                <TextBlock Text="{Binding SideLabel}" FontSize="11"
                                                                           Foreground="{StaticResource PartlyInk}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Sub}" Style="{StaticResource Muted}"
                                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Sub}" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2" Text="{Binding Counts}"
                                                               Style="{StaticResource Figure}"
                                                               VerticalAlignment="Center" Margin="6,0,10,0"
                                                               ToolTip="{Binding CountsTip}" />

                                                    <ItemsControl Grid.Column="3" ItemsSource="{Binding Pills}"
                                                                  VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{Binding Back}" CornerRadius="10"
                                                                        Padding="9,3" Margin="0,0,6,0"
                                                                        ToolTip="{Binding Tip}">
                                                                    <TextBlock Text="{Binding Text}" FontSize="11"
                                                                               Foreground="{Binding Ink}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Button Grid.Column="4" Content="Trace" Click="OnTraceBranch"
                                                            Style="{StaticResource Quiet}"
                                                            VerticalAlignment="Center" Margin="0,0,10,0"
                                                            ToolTip="Show only this branch in the timeline" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.Resources>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                  Background="Transparent" ResizeBehavior="PreviousAndNext"
                                  ShowsPreview="False" />

                    <!-- ===== timeline ===== -->
                    <Border Grid.Column="2" Background="{StaticResource Rail}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                        <DockPanel Margin="16,0,0,0">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,16,8">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="WHAT LANDED, AND WHEN"
                                               Style="{StaticResource SectionHead}"
                                               VerticalAlignment="Center" />
                                    <ComboBox x:Name="TimelineTarget" Width="150"
                                              HorizontalAlignment="Right"
                                              SelectionChanged="OnTimelineTargetChanged" />
                                </Grid>

                                <StackPanel x:Name="TracePanel" Orientation="Horizontal"
                                            Visibility="Collapsed">
                                    <Border Background="{StaticResource PartlyTint}" CornerRadius="10" Padding="9,3">
                                        <TextBlock x:Name="TraceNote" FontSize="11" Foreground="{StaticResource PartlyInk}" />
                                    </Border>
                                    <Button x:Name="BtnClearTrace" Content="Show all" Click="OnClearTrace"
                                            Style="{StaticResource Quiet}" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,16,16">
                                <StackPanel>
                                    <TextBlock x:Name="TimelineEmpty" Style="{StaticResource Muted}"
                                               Margin="0,4,0,10" TextWrapping="Wrap"
                                               Visibility="Collapsed" />

                                    <ItemsControl x:Name="Timeline">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <!-- The day, once, as a band across the
                                                         column rather than a note in a gutter
                                                         that is no longer wide enough for it. -->
                                                    <TextBlock Text="{Binding Day}"
                                                               Visibility="{Binding DayShown}"
                                                               Style="{StaticResource SectionHead}"
                                                               Margin="0,10,0,6" />

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- the spine: one line, a dot per landing -->
                                                        <Grid Grid.Column="0">
                                                            <Border Width="2" Background="{StaticResource Line}"
                                                                    HorizontalAlignment="Center" />
                                                            <Ellipse Width="9" Height="9" Fill="{Binding Accent}"
                                                                     Stroke="{StaticResource Rail}" StrokeThickness="2"
                                                                     VerticalAlignment="Top"
                                                                     HorizontalAlignment="Center"
                                                                     Margin="0,12,0,0" />
                                                        </Grid>

                                                        <Border Grid.Column="1" Margin="6,5,0,5" Padding="11,8"
                                                                Background="{StaticResource Card}"
                                                                BorderBrush="{StaticResource Line}"
                                                                BorderThickness="1"
                                                                CornerRadius="8" Opacity="{Binding Fade}">
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Source}"
                                                                               FontFamily="Consolas"
                                                                               FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding Source}" />
                                                                    <TextBlock Text="{Binding When}"
                                                                               Style="{StaticResource Figure}"
                                                                               Margin="10,0,0,0" />
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Detail}"
                                                                           Style="{StaticResource Muted}"
                                                                           Margin="0,3,0,0"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Detail}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
