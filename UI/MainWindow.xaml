<Window x:Class="CoderMascot.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CoderMascot.UI"
        Title="Coder Mascot"
        Width="1180" Height="780"
        MinWidth="760" MinHeight="520"
        Background="{StaticResource Page}"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Nav icons: 16x16 line drawings, stroked in the item's ink. -->
            <PathGeometry x:Key="IconOverview" Figures="M3.25,2 H5.75 A1.25,1.25 0 0 1 7,3.25 V5.75 A1.25,1.25 0 0 1 5.75,7 H3.25 A1.25,1.25 0 0 1 2,5.75 V3.25 A1.25,1.25 0 0 1 3.25,2 Z M3.25,9 H5.75 A1.25,1.25 0 0 1 7,10.25 V12.75 A1.25,1.25 0 0 1 5.75,14 H3.25 A1.25,1.25 0 0 1 2,12.75 V10.25 A1.25,1.25 0 0 1 3.25,9 Z M10.25,2 H12.75 A1.25,1.25 0 0 1 14,3.25 V5.75 A1.25,1.25 0 0 1 12.75,7 H10.25 A1.25,1.25 0 0 1 9,5.75 V3.25 A1.25,1.25 0 0 1 10.25,2 Z M10.25,9 H12.75 A1.25,1.25 0 0 1 14,10.25 V12.75 A1.25,1.25 0 0 1 12.75,14 H10.25 A1.25,1.25 0 0 1 9,12.75 V10.25 A1.25,1.25 0 0 1 10.25,9 Z" />
            <PathGeometry x:Key="IconProjects" Figures="M2.75,3.25 A1.75,1.75 0 1 0 6.25,3.25 A1.75,1.75 0 1 0 2.75,3.25 Z M2.75,12.75 A1.75,1.75 0 1 0 6.25,12.75 A1.75,1.75 0 1 0 2.75,12.75 Z M9.75,4.5 A1.75,1.75 0 1 0 13.25,4.5 A1.75,1.75 0 1 0 9.75,4.5 Z M4.5,5 V11 M11.5,6.25 C11.5,9.25 4.5,8 4.5,11" />
            <PathGeometry x:Key="IconLogs" Figures="M3.25,2 H12.75 A1,1 0 0 1 13.75,3 V13 A1,1 0 0 1 12.75,14 H3.25 A1,1 0 0 1 2.25,13 V3 A1,1 0 0 1 3.25,2 Z M5,5.5 H5.1 M7.25,5.5 H11 M5,8 H5.1 M7.25,8 H11 M5,10.5 H5.1 M7.25,10.5 H9.5" />
            <PathGeometry x:Key="IconNotes" Figures="M3.5,1.75 H9.5 L12.5,4.75 V13.25 A1,1 0 0 1 11.5,14.25 H4.5 A1,1 0 0 1 3.5,13.25 Z M9.5,1.75 V4.75 H12.5 M5.75,8 H10.25 M5.75,10.75 H10.25" />
            <PathGeometry x:Key="IconPorts" Figures="M3,2.5 H13 A1.25,1.25 0 0 1 14.25,3.75 V5.25 A1.25,1.25 0 0 1 13,6.5 H3 A1.25,1.25 0 0 1 1.75,5.25 V3.75 A1.25,1.25 0 0 1 3,2.5 Z M3,9.5 H13 A1.25,1.25 0 0 1 14.25,10.75 V12.25 A1.25,1.25 0 0 1 13,13.5 H3 A1.25,1.25 0 0 1 1.75,12.25 V10.75 A1.25,1.25 0 0 1 3,9.5 Z M4.75,4.5 H4.85 M4.75,11.5 H4.85" />
            <PathGeometry x:Key="IconSettings" Figures="M2,5 H8.25 M11.75,5 H14 M8.25,5 A1.75,1.75 0 1 0 11.75,5 A1.75,1.75 0 1 0 8.25,5 Z M2,11 H4.25 M7.75,11 H14 M4.25,11 A1.75,1.75 0 1 0 7.75,11 A1.75,1.75 0 1 0 4.25,11 Z" />
            <PathGeometry x:Key="IconCollapse" Figures="M8.5,4 L4.5,8 L8.5,12 M12.5,4 L8.5,8 L12.5,12" />
            <PathGeometry x:Key="IconExpand" Figures="M7.5,4 L11.5,8 L7.5,12 M3.5,4 L7.5,8 L3.5,12" />

            <DataTemplate x:Key="NavTemplate">
                <Button Style="{StaticResource NavItem}" Click="OnNav"
                        ToolTip="{Binding Hover}"
                        AutomationProperties.Name="{Binding Title}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.ColumnSpan="3" Width="3" HorizontalAlignment="Left"
                                Margin="0,7" CornerRadius="0,2,2,0"
                                Background="{Binding Bar}" />

                        <Path Grid.Column="0" Data="{Binding Icon}" Stroke="{Binding Ink}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="16" Height="16" Stretch="None"
                              Margin="12,0,10,0" VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1" Text="{Binding Title}"
                                   Foreground="{Binding Ink}" FontWeight="{Binding Weight}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding LabelShown}" />

                        <Border Grid.Column="2" Height="18" MinWidth="22" CornerRadius="9"
                                Margin="8,0,10,0" VerticalAlignment="Center"
                                Background="{Binding BadgeBack}"
                                Visibility="{Binding BadgeShown}">
                            <TextBlock Text="{Binding Badge}" FontSize="{StaticResource TextLabel}"
                                       Foreground="{Binding BadgeInk}" Margin="6,0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- With the labels gone, an urgent count still has to show. -->
                        <Ellipse Grid.ColumnSpan="3" Width="7" Height="7"
                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Margin="25,6,0,0" Fill="{StaticResource Bad}"
                                 Visibility="{Binding DotShown}" />
                    </Grid>
                </Button>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Client" SizeChanged="OnClientSized">
        <DockPanel x:Name="Shell">
            <!-- title area -->
            <Border DockPanel.Dock="Top" Background="{StaticResource Head}" MinHeight="52" Padding="16,8"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="StatePip" Grid.Column="0" Width="14" Height="14"
                             Fill="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,10,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="HeadTitle" Style="{StaticResource Title}" Text="Checking…" />
                        <TextBlock x:Name="HeadDetail" Style="{StaticResource Muted}"
                                   Text="" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="{StaticResource GapBefore}">
                        <Button Content="Check now" Style="{StaticResource Quiet}" Click="OnCheckNow"
                                Margin="{StaticResource GapButton}" />
                        <Button Content="Open Coder" Style="{StaticResource Quiet}" Click="OnOpenCoder" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- nav -->
            <Border x:Name="NavRail" DockPanel.Dock="Left" Width="208" Background="{StaticResource Rail}"
                    BorderBrush="{StaticResource Hair}" BorderThickness="0,0,1,0" Padding="8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Height="1" Background="{StaticResource Hair}" Margin="4,8,4,8" />
                        <ItemsControl x:Name="NavFoot" ItemTemplate="{StaticResource NavTemplate}" />
                    </StackPanel>

                    <ItemsControl x:Name="NavList" ItemTemplate="{StaticResource NavTemplate}" />
                </DockPanel>
            </Border>

            <!-- page host -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="24,16,24,12">
                    <TextBlock x:Name="PageTitle" Style="{StaticResource Title}" />
                    <TextBlock x:Name="PageSub" Style="{StaticResource Muted}" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <!-- ================= overview ================= -->
                    <ScrollViewer x:Name="PageOverview" VerticalScrollBarVisibility="Auto"
                                  Padding="24,0,24,24" Visibility="Collapsed"
                                  SizeChanged="OnOverviewSized">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="1080" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <!-- workspace -->
                                <Border Style="{StaticResource CardBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse x:Name="WorkspacePip" Width="10" Height="10"
                                                         Fill="{StaticResource Dim}" VerticalAlignment="Center"
                                                         Margin="{StaticResource GapAfter}" />
                                                <TextBlock x:Name="WorkspaceTitle" Grid.Column="1" Style="{StaticResource Title}"
                                                           Text="Checking…" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                            <TextBlock x:Name="WorkspaceFacts" Style="{StaticResource Muted}"
                                                       TextWrapping="Wrap" Text="—" Margin="18,4,0,0" />
                                        </StackPanel>

                                        <!-- Beside the facts on a wide page, under them on a narrow one. -->
                                        <StackPanel x:Name="WorkspaceActions" Grid.Row="0" Grid.Column="1"
                                                    Orientation="Horizontal" VerticalAlignment="Center"
                                                    Margin="16,0,0,0">
                                            <Button x:Name="BtnStart" Content="Start" Click="OnStartWorkspace" Margin="{StaticResource GapButton}" />
                                            <Button x:Name="BtnStop" Content="Stop" Click="OnStopWorkspace" Margin="{StaticResource GapButton}" />
                                            <Button x:Name="BtnRestart" Content="Restart" Click="OnRestartWorkspace" Margin="{StaticResource GapButton}" />
                                            <Button x:Name="BtnLogin" Content="coder login" Click="OnCoderLogin" Margin="{StaticResource GapButton}" />
                                            <Button Content="Connect…" Click="OnShowSetup"
                                                    ToolTip="Set the Coder address and session token from here" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="OverviewRightColumn" Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel x:Name="OverviewLeft" Grid.Column="0">
                                        <!-- Claude sessions -->
                                        <StackPanel Margin="0,24,0,0">
                                            <TextBlock Text="CLAUDE SESSIONS" Style="{StaticResource SectionHead}"
                                                       Margin="0,0,0,8" />
                                            <TextBlock x:Name="SessionsEmpty" Style="{StaticResource Muted}"
                                                       Text="No sessions." Visibility="Collapsed" TextWrapping="Wrap" />
                                            <ItemsControl x:Name="SessionList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource Hair}" BorderThickness="0,0,0,1"
                                                                MinHeight="44" Padding="0,6">
                                                            <Grid VerticalAlignment="Center">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <Ellipse Grid.Column="0" Width="9" Height="9" Margin="{StaticResource GapAfter}"
                                                                         VerticalAlignment="Center" Fill="{Binding Pip}" />

                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding Folder}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Activity}" Style="{StaticResource Muted}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>

                                                                <TextBlock Grid.Column="2" Text="{Binding Age}"
                                                                           Style="{StaticResource Muted}"
                                                                           VerticalAlignment="Center" Margin="8,0" />

                                                                <Button Grid.Column="3" Content="Go to it" Click="OnGoToSession"
                                                                        VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- left running -->
                                        <StackPanel Margin="0,24,0,0">
                                            <TextBlock Text="LEFT RUNNING" Style="{StaticResource SectionHead}"
                                                       Margin="0,0,0,8" />
                                            <TextBlock x:Name="LeftoversEmpty" Style="{StaticResource Muted}"
                                                       Text="Nothing left running." TextWrapping="Wrap" />
                                            <ItemsControl x:Name="LeftoverList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource Hair}" BorderThickness="0,0,0,1"
                                                                MinHeight="44" Padding="0,6">
                                                            <Grid VerticalAlignment="Center">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Sub}" Style="{StaticResource Muted}" />
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Content="{Binding Action}"
                                                                        Click="OnLeftoverAction" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel x:Name="OverviewRight" Grid.Column="1" Margin="32,0,0,0">
                                        <!-- this machine -->
                                        <StackPanel x:Name="SectionMachine" Margin="0,24,0,0">
                                            <TextBlock Text="THIS MACHINE" Style="{StaticResource SectionHead}"
                                                       Margin="0,0,0,8" />

                                            <Border BorderBrush="{StaticResource Hair}" BorderThickness="0,0,0,1" MinHeight="36">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="CPU" Style="{StaticResource Muted}" />
                                                    <Border Grid.Column="1" Height="8" CornerRadius="4" Background="{StaticResource Well}"
                                                            HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                        <Border x:Name="CpuBar" HorizontalAlignment="Left" CornerRadius="4"
                                                                Background="{StaticResource Cpu}" Width="0" />
                                                    </Border>
                                                    <TextBlock Grid.Column="2" x:Name="CpuText" Text="—"
                                                               Style="{StaticResource Muted}" Margin="{StaticResource GapBefore}" />
                                                </Grid>
                                            </Border>

                                            <Border BorderBrush="{StaticResource Hair}" BorderThickness="0,0,0,1" MinHeight="36">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="RAM" Style="{StaticResource Muted}" />
                                                    <Border Grid.Column="1" Height="8" CornerRadius="4" Background="{StaticResource Well}"
                                                            HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                        <Border x:Name="MemBar" HorizontalAlignment="Left" CornerRadius="4"
                                                                Background="{StaticResource Mem}" Width="0" />
                                                    </Border>
                                                    <TextBlock Grid.Column="2" x:Name="MemText" Text="—"
                                                               Style="{StaticResource Muted}" Margin="{StaticResource GapBefore}" />
                                                </Grid>
                                            </Border>

                                            <ItemsControl x:Name="CulpritList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource Hair}" BorderThickness="0,0,0,1"
                                                                MinHeight="44" Padding="0,6">
                                                            <Grid VerticalAlignment="Center">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                    <TextBlock Text="{Binding Title}" />
                                                                    <TextBlock Text="{Binding Sub}" Style="{StaticResource Muted}" />
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Content="Close all" Click="OnCloseFamily"
                                                                        VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- recent -->
                                        <StackPanel x:Name="SectionRecent" Margin="0,24,0,0">
                                            <TextBlock Text="RECENT" Style="{StaticResource SectionHead}"
                                                       Margin="0,0,0,8" />
                                            <ItemsControl x:Name="HistoryList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource Hair}" BorderThickness="0,0,0,1"
                                                                MinHeight="36" Padding="0,4">
                                                            <Grid VerticalAlignment="Center">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Time}"
                                                                           Style="{StaticResource Muted}" Margin="0,0,10,0" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                                           Foreground="{Binding Pip}" Margin="{StaticResource GapAfter}" />
                                                                <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                                                           Style="{StaticResource Muted}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- ================= projects ================= -->
                    <!-- Filled in by the constructor. The page is a control of its own, so
                         this file stays about the window; it is full-bleed like Notes, with
                         no scroller or padding of its own around it. -->
                    <Border x:Name="PageProjects" Visibility="Collapsed" />

                    <!-- ================= logs ================= -->
                    <!-- Filled in by the constructor, like Projects, and full-bleed for the same reason. -->
                    <Border x:Name="PageLogs" Visibility="Collapsed" />

                    <!-- ================= notes ================= -->
                    <Grid x:Name="PageNotes" Visibility="Collapsed" SizeChanged="OnNotesSized">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="NotesListsColumn" Width="240" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- the lists -->
                        <Border Grid.Column="0" Background="{StaticResource Sunk}"
                                BorderBrush="{StaticResource Hair}" BorderThickness="0,0,1,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="5,8,5,16">
                                <!-- Room for the focus ring, which the scroller would otherwise clip. -->
                                <StackPanel Margin="3,0">
                                    <TextBlock Text="LISTS" Style="{StaticResource SectionHead}" Margin="12,0,12,8" />

                                    <ItemsControl x:Name="GroupTabs">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource NavItem}" Click="OnPickGroup">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.ColumnSpan="2" Width="3" HorizontalAlignment="Left"
                                                                Margin="0,7" CornerRadius="0,2,2,0"
                                                                Background="{Binding Bar}" />

                                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                                   Foreground="{Binding Ink}" FontWeight="{Binding Weight}"
                                                                   Margin="12,0,8,0" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />

                                                        <Border Grid.Column="1" Height="18" MinWidth="22" CornerRadius="9"
                                                                Margin="0,0,10,0" VerticalAlignment="Center"
                                                                Background="{StaticResource Lift}"
                                                                Visibility="{Binding OpenShown}">
                                                            <TextBlock Text="{Binding Open}" FontSize="{StaticResource TextLabel}"
                                                                       Foreground="{StaticResource Ink2}" Margin="6,0"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="+ New list" Style="{StaticResource Quiet}" Click="OnNewGroup"
                                            HorizontalAlignment="Left" Margin="4,10,0,0" />

                                    <!-- Naming a list, in place: a modal dialog for one short
                                         string is more window than the job deserves. -->
                                    <StackPanel x:Name="GroupEditor" Visibility="Collapsed" Margin="4,12,4,0">
                                        <TextBox x:Name="GroupName" MaxLength="40"
                                                 PreviewKeyDown="OnGroupNameKey" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Content="Save" Style="{StaticResource Quiet}" Click="OnSaveGroup"
                                                    Margin="{StaticResource GapButton}" />
                                            <Button Content="Cancel" Style="{StaticResource Quiet}" Click="OnCancelGroup" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="4,12,0,0">
                                        <Button x:Name="BtnRenameGroup" Content="Rename" Style="{StaticResource Quiet}"
                                                Click="OnRenameGroup" Margin="{StaticResource GapButton}" />
                                        <Button x:Name="BtnDeleteGroup" Content="Delete list" Style="{StaticResource Quiet}"
                                                Click="OnDeleteGroup" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- the notes -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="1080" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="24,0,24,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="NoteEntry" Grid.Column="0" Margin="{StaticResource GapButton}"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 MinHeight="34" MaxHeight="90"
                                                 VerticalScrollBarVisibility="Auto"
                                                 PreviewKeyDown="OnNoteEntryKey" />
                                        <Button Grid.Column="1" Content="Add" Style="{StaticResource Primary}"
                                                Click="OnAddNote" VerticalAlignment="Top" MinHeight="34" />
                                    </Grid>
                                    <TextBlock x:Name="NoteHint" Style="{StaticResource Muted}" Margin="0,4,0,0"
                                               Text="Enter adds it · Shift+Enter for another line" />
                                    <TextBlock x:Name="HotkeyHint" Style="{StaticResource Muted}" Margin="0,2,0,0"
                                               Text="" />

                                    <TextBox x:Name="NoteFilter" Margin="0,12,0,0" ui:Field.Hint="Filter notes"
                                             TextChanged="OnNoteFilterChanged" />

                                    <TextBlock x:Name="NotesEmpty" Style="{StaticResource Muted}"
                                               Text="Nothing noted yet." TextWrapping="Wrap" Margin="0,10,0,0" />
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" Padding="24,0,22,16">
                                    <ItemsControl x:Name="NoteList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource Row}" BorderBrush="{StaticResource Line}"
                                                        BorderThickness="1" CornerRadius="6"
                                                        Padding="0" Margin="0,3,2,3"
                                                        Opacity="{Binding Fade}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="4" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- The paper this note is written on, so the list and
                                                             the desktop agree about which note is which. -->
                                                        <Border Grid.Column="0" Background="{Binding Paper}"
                                                                CornerRadius="6,0,0,6" />

                                                        <CheckBox Grid.Column="1" IsChecked="{Binding Done, Mode=OneTime}"
                                                                  Click="OnNoteDone" ToolTip="Done with it"
                                                                  VerticalAlignment="Top" Margin="8,9,8,0" />

                                                        <StackPanel Grid.Column="2" Margin="0,6,0,6">
                                                            <TextBox Text="{Binding Text, Mode=OneTime}" Style="{StaticResource Inline}"
                                                                     TextChanged="OnNoteTextChanged"
                                                                     LostFocus="OnNoteBlur"
                                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                                     BorderThickness="0" Background="Transparent"
                                                                     Padding="0" Margin="0"
                                                                     Foreground="{Binding Ink}"
                                                                     CaretBrush="{StaticResource Ink}" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                <TextBlock Text="{Binding When}"
                                                                           Style="{StaticResource Muted}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="{StaticResource GapAfter}" />
                                                                <ComboBox ItemsSource="{Binding Groups}"
                                                                          SelectedItem="{Binding Group, Mode=OneTime}"
                                                                          Visibility="{Binding PickerShown}"
                                                                          SelectionChanged="OnNoteGroupChanged"
                                                                          MinWidth="110" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <Button Grid.Column="3" Content="{Binding StickLabel}"
                                                                Click="OnNoteStick" VerticalAlignment="Top"
                                                                ToolTip="Put this note on the desktop"
                                                                Margin="6,6,4,0" MinWidth="70" />
                                                        <Button Grid.Column="4" Content="{Binding PinLabel}"
                                                                Click="OnNotePin" VerticalAlignment="Top"
                                                                Margin="0,6,4,0" MinWidth="52" />
                                                        <Button Grid.Column="5" Content="Delete"
                                                                Click="OnNoteDelete" VerticalAlignment="Top"
                                                                Margin="0,6,8,0" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <Border Grid.Row="1" Background="{StaticResource Head}"
                                    BorderBrush="{StaticResource Hair}" BorderThickness="0,1,0,0" Padding="24,10">
                                <!-- Same right edge as the notes above: 1080 less their 24 + 24. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MaxWidth="1032" />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <TextBlock x:Name="NotesCount" Style="{StaticResource Muted}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="BtnClearDone" Content="Clear done" Style="{StaticResource Quiet}"
                                                    Click="OnClearDoneNotes" Margin="{StaticResource GapButton}" />
                                            <Button Content="Open notes file…" Style="{StaticResource Quiet}"
                                                    Click="OnOpenNotesFile" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ================= ports ================= -->
                    <ScrollViewer x:Name="PagePorts" VerticalScrollBarVisibility="Auto"
                                  Padding="24,0,24,24" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="1080" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBox x:Name="PortFilter" Width="320"
                                             ui:Field.Hint="Filter by port or process"
                                             ToolTip="A port number, or part of a process name"
                                             TextChanged="OnPortFilterChanged" />
                                    <CheckBox x:Name="SystemPortsBox" Style="{StaticResource Switch}"
                                              Content="System ports"
                                              VerticalAlignment="Center" Margin="16,0,0,0"
                                              ToolTip="Also show ports below 1024 — mostly Windows itself"
                                              Click="OnPortFilterChanged" />
                                </StackPanel>

                                <TextBlock x:Name="PortsEmpty" Style="{StaticResource Muted}"
                                           Text="Checking…" TextWrapping="Wrap" Margin="0,0,0,8" />

                                <Border BorderBrush="{StaticResource Hair}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="128" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="PORT" Style="{StaticResource SectionHead}" />
                                        <TextBlock Grid.Column="1" Text="PROCESS" Style="{StaticResource SectionHead}" />
                                        <TextBlock Grid.Column="2" Text="ACTIONS" Style="{StaticResource SectionHead}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>

                                <ItemsControl x:Name="PortList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Hair}" BorderThickness="0,0,0,1"
                                                    MinHeight="44" Padding="0,6">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="76" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="128" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding Port}"
                                                               Foreground="{Binding Pip}"
                                                               FontFamily="{StaticResource FaceMono}"
                                                               FontSize="{StaticResource TextBody}"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Sub}" Style="{StaticResource Muted}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Content="Open" Style="{StaticResource Quiet}" Click="OnOpenPort"
                                                                Margin="{StaticResource GapButton}"
                                                                ToolTip="Open http://localhost:port in your browser" />
                                                        <Button Content="Close" Style="{StaticResource Quiet}" Click="OnClosePort" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="PortsCount" Style="{StaticResource Muted}" Margin="0,12,0,0" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- ================= settings ================= -->
                    <Grid x:Name="PageSettings" Visibility="Collapsed" SizeChanged="OnSettingsSized">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="SettingsIndexColumn" Width="240" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- the sections -->
                        <Border Grid.Column="0" Background="{StaticResource Sunk}"
                                BorderBrush="{StaticResource Hair}" BorderThickness="0,0,1,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="5,8,5,16">
                                <!-- Room for the focus ring, which the scroller would otherwise clip. -->
                                <StackPanel Margin="3,0">
                                    <TextBlock Text="SECTIONS" Style="{StaticResource SectionHead}" Margin="12,0,12,8" />

                                    <ItemsControl x:Name="SectionIndex">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource NavItem}" Click="OnPickSection"
                                                        AutomationProperties.Name="{Binding Title}">
                                                    <Grid>
                                                        <Border Width="3" HorizontalAlignment="Left"
                                                                Margin="0,7" CornerRadius="0,2,2,0"
                                                                Background="{Binding Bar}" />

                                                        <TextBlock Text="{Binding Title}"
                                                                   Foreground="{Binding Ink}" FontWeight="{Binding Weight}"
                                                                   Margin="12,0,8,0" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- the settings -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollViewer x:Name="SettingsScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" Padding="24,0,24,24"
                                          ScrollChanged="OnSettingsScrolled">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MaxWidth="1080" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <!-- One heading per concern. They were one card with twelve
                                             controls in it, which is how a settings screen ends up
                                             read as a control panel: nothing tells you which knob
                                             belongs to which question. -->

                                        <TextBlock x:Name="HeadMessages" Text="HOW MUCH IT INTERRUPTS"
                                                   Style="{StaticResource SectionTop}" Margin="0,0,0,8" />
                                        <Border Style="{StaticResource CardBorder}">
                                            <StackPanel>
                                                <TextBlock Text="Messages" />
                                                <Border HorizontalAlignment="Left" Margin="0,6,0,0" Padding="2"
                                                        Background="{StaticResource Sunk}" BorderBrush="{StaticResource Line}"
                                                        BorderThickness="1" CornerRadius="6">
                                                    <UniformGrid Rows="1" AutomationProperties.Name="Messages">
                                                        <RadioButton x:Name="MessagesAll" Content="Show everything" GroupName="Messages"
                                                                     Style="{StaticResource Segment}" Checked="OnSettingEdited" />
                                                        <RadioButton x:Name="MessagesQuiet" Content="Quiet" GroupName="Messages"
                                                                     Style="{StaticResource Segment}" Checked="OnSettingEdited" />
                                                        <RadioButton x:Name="MessagesOff" Content="Off" GroupName="Messages"
                                                                     Style="{StaticResource Segment}" Checked="OnSettingEdited" />
                                                    </UniformGrid>
                                                </Border>
                                                <TextBlock x:Name="MessagesNote" Style="{StaticResource Prose}" Margin="0,8,0,0" />

                                                <CheckBox x:Name="AnnounceBox" Style="{StaticResource Switch}"
                                                          Content="Tell me when a Claude session finishes"
                                                          Margin="0,14,0,0" Click="OnSettingEdited" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock x:Name="HeadStartup" Text="STARTUP" Style="{StaticResource SectionTop}" />
                                        <Border Style="{StaticResource CardBorder}">
                                            <CheckBox x:Name="StartupBox" Style="{StaticResource Switch}"
                                                      Content="Start Coder Mascot when I log in to Windows"
                                                      Click="OnSettingEdited" />
                                        </Border>

                                        <TextBlock x:Name="HeadWarnings" Text="WHEN TO WARN ME" Style="{StaticResource SectionTop}" />
                                        <Border Style="{StaticResource CardBorder}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Prose}" Margin="0,0,0,10"
                                                           Text="Most people never change these. Each one says what it accepts, because a value outside the range is quietly clamped rather than refused." />

                                                <!-- One row per setting, label and field on the same
                                                     line as the range they accept. This was a
                                                     UniformGrid four columns wide with the labels in one
                                                     row and the fields in the next, so which label
                                                     belonged to which box was a matter of counting. -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU busy above"
                                                               VerticalAlignment="Center" Margin="0,0,10,6" />
                                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="CpuLimitBox" Margin="0,0,10,6"
                                                             TextChanged="OnSettingEdited" />
                                                    <TextBlock Grid.Row="0" Grid.Column="2" x:Name="CpuRange" Style="{StaticResource Muted}"
                                                               VerticalAlignment="Center" Margin="0,0,0,6"
                                                               Text="per cent &#x00B7; 40 to 99" />

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="RAM busy above"
                                                               VerticalAlignment="Center" Margin="0,0,10,6" />
                                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="MemLimitBox" Margin="0,0,10,6"
                                                             TextChanged="OnSettingEdited" />
                                                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="MemRange" Style="{StaticResource Muted}"
                                                               VerticalAlignment="Center" Margin="0,0,0,6"
                                                               Text="per cent &#x00B7; 40 to 99" />

                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Workspace idle for"
                                                               VerticalAlignment="Center" Margin="0,0,10,6" />
                                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="WsIdleBox" Margin="0,0,10,6"
                                                             TextChanged="OnSettingEdited" />
                                                    <TextBlock Grid.Row="2" Grid.Column="2" x:Name="WsIdleRange" Style="{StaticResource Muted}"
                                                               VerticalAlignment="Center" Margin="0,0,0,6"
                                                               Text="minutes &#x00B7; 5 to 10080, or 0 to never ask" />

                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Dev server idle for"
                                                               VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="DevIdleBox" Margin="0,0,10,0"
                                                             TextChanged="OnSettingEdited" />
                                                    <TextBlock Grid.Row="3" Grid.Column="2" x:Name="DevIdleRange" Style="{StaticResource Muted}"
                                                               VerticalAlignment="Center"
                                                               Text="minutes &#x00B7; 5 to 10080, or 0 to never ask" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock x:Name="HeadConfig" Text="EVERYTHING ELSE" Style="{StaticResource SectionTop}" />
                                        <Border Style="{StaticResource CardBorder}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Prose}" Margin="0,0,0,10"
                                                           Text="Everything else lives in the config file. The app reads it when it starts, so restart it after editing." />
                                                <Button Content="Edit config file&#x2026;" Click="OnEditConfig"
                                                        HorizontalAlignment="Left" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>

                            <!-- Only while something differs from what is saved (D5). -->
                            <Border x:Name="ApplyBar" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource Head}"
                                    BorderBrush="{StaticResource Hair}" BorderThickness="0,1,0,0" Padding="24,10">
                                <!-- Same right edge as the sections above. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MaxWidth="1080" />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <TextBlock x:Name="ApplyText" Style="{StaticResource Muted}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel x:Name="ApplyActions" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Discard" Style="{StaticResource Quiet}"
                                                    Click="OnDiscardSettings" Margin="{StaticResource GapButton}" />
                                            <Button Content="Apply" Style="{StaticResource Primary}"
                                                    Click="OnApplySettings" ToolTip="Apply  (Ctrl+S)" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </DockPanel>

        <!-- ================= drawer =================
             A modal panel over the whole client area, for the forms. The shell
             underneath is switched off while it is open, so neither the mouse,
             Tab nor the page shortcuts reach it; a click on the dim does
             nothing, because a long form must not be lost to a stray click. -->
        <Grid x:Name="DrawerLayer" Visibility="Collapsed"
              KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle">
            <Rectangle x:Name="DrawerScrim" Fill="{StaticResource Scrim}" />

            <Border x:Name="DrawerPanel" HorizontalAlignment="Right" Width="480"
                    Background="{StaticResource Page}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="DrawerShift" />
                </Border.RenderTransform>

                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource DrawerHead}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock x:Name="DrawerTitle" Style="{StaticResource Title}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="DrawerSub" Style="{StaticResource Prose}"
                                           Margin="0,4,0,0" Visibility="Collapsed" />
                            </StackPanel>

                            <Button Grid.Column="1" Content="&#x00D7;" Style="{StaticResource DrawerClose}"
                                    Click="OnDrawerClose" VerticalAlignment="Top" Margin="8,-4,-6,0"
                                    ToolTip="Close  (Esc)" AutomationProperties.Name="Close" />
                        </Grid>
                    </Border>

                    <ContentPresenter x:Name="DrawerBody" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
