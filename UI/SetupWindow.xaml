<Window x:Class="CoderMascot.UI.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect Coder Mascot"
        Width="520" SizeToContent="Height"
        MinWidth="460"
        Background="{StaticResource Page}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <Style x:Key="Step" TargetType="TextBlock" BasedOn="{StaticResource Title}">
            <Setter Property="FontSize" Value="{StaticResource TextBody}" />
            <Setter Property="Margin" Value="0,16,0,4" />
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="22,18,22,18">
        <TextBlock Text="Point the mascot at your workspace" Style="{StaticResource Title}" />
        <TextBlock Style="{StaticResource Prose}" Margin="0,4,0,0"
                   Text="Two things: where Coder lives, and a session token so it can ask about your workspace. Nothing is saved until it has been checked." />

        <TextBlock Text="1 · Your Coder address" Style="{StaticResource Step}" />
        <TextBox x:Name="UrlBox" TextChanged="OnUrlChanged" />
        <TextBlock x:Name="UrlNote" Style="{StaticResource Prose}" Margin="0,4,0,0" />

        <TextBlock Text="2 · Get a session token" Style="{StaticResource Step}" />
        <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnOpen" Content="Open the token page" Click="OnOpenTokenPage" />
            <TextBlock x:Name="OpenNote" Style="{StaticResource Prose}" VerticalAlignment="Center"
                       Margin="10,0,0,0" Text="Opens in your browser. Sign in, then copy the token." />
        </StackPanel>

        <TextBlock Text="3 · Paste it here" Style="{StaticResource Step}" />
        <PasswordBox x:Name="TokenBox" PasswordChanged="OnTokenChanged" />

        <StackPanel x:Name="WorkspacePick" Visibility="Collapsed" Margin="0,14,0,0">
            <TextBlock Text="You own more than one workspace — which should the mascot watch?" />
            <ComboBox x:Name="WorkspaceBox" Margin="0,6,0,0" SelectionChanged="OnWorkspaceChosen" />
        </StackPanel>

        <Border x:Name="StatusPanel" Margin="0,16,0,0" CornerRadius="6" Padding="10,8"
                Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                Visibility="Collapsed">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="BtnLater" Content="Not now" Click="OnLater" Margin="{StaticResource GapAfter}" />
            <Button x:Name="BtnConnect" Content="Connect" Style="{StaticResource Primary}"
                    Click="OnConnect" IsDefault="True" />
        </StackPanel>

        <TextBlock Style="{StaticResource Prose}" Margin="0,12,0,0"
                   Text="Already use the Coder CLI? Run `coder login` and the mascot picks that up on its own — nothing to fill in here." />
    </StackPanel>
</Window>
