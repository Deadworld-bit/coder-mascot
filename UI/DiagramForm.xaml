<UserControl x:Class="CoderMascot.UI.DiagramForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Merged here, not left to the main window: a control parses its
                 markup before it has a parent. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <!-- footer -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DrawerFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="OnCancel" Margin="{StaticResource GapAfter}" />
                <Button x:Name="BtnSave" Content="Save" Style="{StaticResource Primary}"
                        Click="OnSave" IsDefault="True" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,4,22,18">
            <StackPanel>

                <TextBlock Text="NAME" Style="{StaticResource SectionTop}" Margin="0,14,0,6" />
                <TextBox x:Name="TitleBox" AutomationProperties.Name="Name" />
                <TextBlock Style="{StaticResource Prose}" Margin="0,5,0,0"
                           Text="Optional. Defaults to the file name." />

                <TextBlock Text="FILE OR LINK" Style="{StaticResource SectionTop}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" x:Name="TargetBox" FontFamily="Consolas"
                             AutomationProperties.Name="File or link" TextChanged="OnTargetChanged" />
                    <Button Grid.Column="1" Content="Browse…" Margin="{StaticResource GapBefore}"
                            Click="OnBrowse" />
                </Grid>
                <TextBlock Style="{StaticResource Prose}" Margin="0,5,0,0"
                           Text="A .drawio, .dio, .drawio.svg or .drawio.png file, like D:\work\db.drawio, or an https link." />

                <TextBlock x:Name="ProblemText" Foreground="{StaticResource BadInk}" TextWrapping="Wrap"
                           Margin="0,10,0,0" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
