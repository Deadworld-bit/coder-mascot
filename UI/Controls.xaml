<!--
    Every control style the chrome windows use, once.

    They used to live in each window separately, and four copies of a palette
    drift apart one edit at a time — measurably: `SectionHead` had three
    different margins, `TextBox` four different paddings, and the *primary*
    button was 14×7 at 13px in one window and 10×5 at 12px in another. None of
    that was a decision; it was four files being edited on different days.

    Merged per-window rather than into App.xaml, deliberately. The implicit
    styles here would otherwise also repaint the sticky note — which is yellow
    paper with a text area on it — and the speech bubble, which are desktop
    objects rather than app chrome and have their own look on purpose.

    Colours come from UI/Theme.xaml, which IS application-wide. The menus are in
    UI/Menus.xaml, merged below so every window here gets them; the mascot, which
    does not merge this file, merges that one directly.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:ui="clr-namespace:CoderMascot.UI">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/UI/Menus.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ===================== the scales =====================

         Spacing is a 4px grid with 6 and 10 allowed as half-steps, because a
         one-line control centred in a 4-grid box lands on a half-step often
         enough that forbidding them just produces 8s that look like 6s.

         These are the vocabulary. Where a style below can carry the spacing it
         does, so the value is applied once rather than typed at each use site —
         that, rather than the naming, is what actually keeps it consistent. -->

    <!-- Thicknesses rather than a scale of Doubles, because XAML cannot compose
         a Thickness out of Doubles: a `Space2` would be a number nothing could
         actually be spaced by. Only the values that repeat enough to be worth
         one definition are here — a name for a one-off gap is harder to read
         than the number it replaces, not easier. -->
    <Thickness x:Key="GapAfter">0,0,8,0</Thickness>
    <Thickness x:Key="GapBefore">8,0,0,0</Thickness>
    <Thickness x:Key="GapBelow">0,0,0,8</Thickness>

    <!-- Type: four sizes, no halves. A half-pixel face rounds unpredictably
         from line to line under TextFormattingMode="Display", which reads as
         badly-set text and is very hard to place if you don't know it. -->
    <sys:Double x:Key="TextLabel">11</sys:Double>
    <sys:Double x:Key="TextSmall">12</sys:Double>
    <sys:Double x:Key="TextBody">13</sys:Double>
    <sys:Double x:Key="TextTitle">15</sys:Double>

    <!-- FontFamily, not sys:String: these are consumed as
         `<Setter Property="FontFamily" Value="{StaticResource FaceUi}" />`, and a
         StaticResource assigns the resolved object with no type conversion. A
         String reaches the FontFamily property unconverted, and the first text
         measure throws InvalidCastException in GetTypeface. -->
    <FontFamily x:Key="FaceUi">Segoe UI</FontFamily>
    <FontFamily x:Key="FaceMono">Consolas</FontFamily>

    <!-- Shared paddings, so a card in one window is a card in the next. -->
    <Thickness x:Key="PadCard">14,12</Thickness>
    <Thickness x:Key="PadField">8,6</Thickness>
    <Thickness x:Key="GapSection">0,16,0,8</Thickness>
    <Thickness x:Key="GapButton">0,0,6,0</Thickness>

    <!-- ===================== text ===================== -->

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource FaceUi}" />
        <Setter Property="FontSize" Value="{StaticResource TextBody}" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!-- Secondary text inside a row or a list. No wrapping: these sit in rows
         of a fixed height, and a second line there changes the row's height
         rather than the text's. Prose that should wrap uses Prose below. -->
    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Faint}" />
        <Setter Property="FontFamily" Value="{StaticResource FaceUi}" />
        <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!-- The same, for explanation under a field or in a card. -->
    <Style x:Key="Prose" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Counts, times and shas line up in columns, so they get tabular figures. -->
    <Style x:Key="Figure" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Faint}" />
        <Setter Property="FontFamily" Value="{StaticResource FaceMono}" />
        <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
    </Style>

    <!-- No margin: the caller places it, because a pinned toolbar and a
         scrolling form want different space above a heading. SectionTop is the
         stacked-form version. -->
    <Style x:Key="SectionHead" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Faint}" />
        <Setter Property="FontFamily" Value="{StaticResource FaceUi}" />
        <Setter Property="FontSize" Value="{StaticResource TextLabel}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SectionTop" TargetType="TextBlock" BasedOn="{StaticResource SectionHead}">
        <Setter Property="Margin" Value="{StaticResource GapSection}" />
    </Style>

    <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource FaceUi}" />
        <Setter Property="FontSize" Value="{StaticResource TextTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ===================== buttons ===================== -->

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="{StaticResource Line}" />
        <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontFamily" Value="{StaticResource FaceUi}" />
        <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="5"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <!-- Honours the content alignment: a row that asks for Stretch
                             has to get it, or every row centres its own content. -->
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Edge}" />
                        </Trigger>

                        <!-- Pressed reads as a press, rather than as hover that
                             happens to be under the finger. -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Lift}" />
                        </Trigger>

                        <!-- Keyboard users need to see where they are, and the
                             default WPF dotted rectangle is invisible on this
                             background. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Pick}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One primary action per screen. Its fill is a step darker than the
         accent so the border still reads as an edge — they were collapsed onto
         the same value at one point, which flattened it into a blue slab. -->
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource PickFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource Pick}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontSize" Value="{StaticResource TextBody}" />
    </Style>

    <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="Foreground" Value="{StaticResource Faint}" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="FontSize" Value="{StaticResource TextLabel}" />
    </Style>

    <!-- Destructive, and visually separated from the action beside it. -->
    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource BadTint}" />
        <Setter Property="BorderBrush" Value="{StaticResource BadEdge}" />
        <Setter Property="Foreground" Value="{StaticResource BadInk}" />
    </Style>

    <!-- ===================== scrollbars ===================== -->

    <!-- Clicking the empty track still pages; there is just nothing to see. -->
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ten pixels to grab, six drawn: the thumb is thin, the target is not. -->
    <Style x:Key="ScrollThumbV" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Padding" Value="2,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent">
                        <Border x:Name="Bar" CornerRadius="3" Margin="{TemplateBinding Padding}"
                                Background="{StaticResource Line}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource Edge}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource Faint}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumbH" TargetType="Thumb" BasedOn="{StaticResource ScrollThumbV}">
        <Setter Property="Padding" Value="0,2" />
    </Style>

    <ControlTemplate x:Key="ScrollBarVTemplate" TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPage}" Command="{x:Static ScrollBar.PageUpCommand}" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPage}" Command="{x:Static ScrollBar.PageDownCommand}" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumbV}" />
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="ScrollBarHTemplate" TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPage}" Command="{x:Static ScrollBar.PageLeftCommand}" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPage}" Command="{x:Static ScrollBar.PageRightCommand}" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumbH}" />
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <!-- OverridesDefaultStyle, because the system style's 17px MinWidth would
         otherwise survive underneath this one. -->
    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template" Value="{StaticResource ScrollBarVTemplate}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Template" Value="{StaticResource ScrollBarHTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The system template without the light-grey square where the bars meet.
         Padding must stay on the presenter: a TextBox passes its own down here. -->
    <ControlTemplate x:Key="ScrollViewerTemplate" TargetType="ScrollViewer">
        <Grid Background="{TemplateBinding Background}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="0" Grid.Row="0"
                                    Margin="{TemplateBinding Padding}"
                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                    CanHorizontallyScroll="False" CanVerticallyScroll="False"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Grid.Row="0"
                       AutomationProperties.AutomationId="VerticalScrollBar" Cursor="Arrow"
                       Minimum="0" Maximum="{TemplateBinding ScrollableHeight}"
                       ViewportSize="{TemplateBinding ViewportHeight}"
                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Column="0" Grid.Row="1" Orientation="Horizontal"
                       AutomationProperties.AutomationId="HorizontalScrollBar" Cursor="Arrow"
                       Minimum="0" Maximum="{TemplateBinding ScrollableWidth}"
                       ViewportSize="{TemplateBinding ViewportWidth}"
                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                       Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="ScrollViewer">
        <Setter Property="Template" Value="{StaticResource ScrollViewerTemplate}" />
    </Style>

    <!-- ===================== fields ===================== -->

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource FaceUi}" />
        <Setter Property="FontSize" Value="{StaticResource TextBody}" />
        <Setter Property="Padding" Value="{StaticResource PadField}" />
        <Setter Property="Background" Value="{StaticResource Well}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame" CornerRadius="6" SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />

                            <!-- The extra 2px on the left is where the text view starts the caret. -->
                            <TextBlock x:Name="Hint" Visibility="Collapsed" IsHitTestVisible="False"
                                       Text="{Binding (ui:Field.Hint), RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{StaticResource Dim}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Margin="{TemplateBinding Padding}" Padding="2,0,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Edge}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Pick}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The one that sits inside a list row and has to stay row-height. -->
    <Style x:Key="Inline" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
        <Setter Property="Padding" Value="4,3" />
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource FaceUi}" />
        <Setter Property="FontSize" Value="{StaticResource TextBody}" />
        <Setter Property="Padding" Value="{StaticResource PadField}" />
        <Setter Property="Background" Value="{StaticResource Well}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Frame" CornerRadius="6" SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Edge}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Pick}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== dropdowns ===================== -->

    <!-- The ComboBox keeps keyboard focus, so the hover, open and focus borders are
         set from its template, not here. -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border CornerRadius="6" SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Path Data="M 0,0 L 4,4 L 8,0" Stroke="{StaticResource Faint}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                              IsHitTestVisible="False" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The text part of an editable ComboBox: bare, because the box around it is drawn
         by the ComboBox. -->
    <Style x:Key="ComboEditBox" TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="ComboTemplate" TargetType="ComboBox">
        <Grid x:Name="Root" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>

            <Popup x:Name="PART_Popup" Grid.ColumnSpan="2" Placement="Bottom" VerticalOffset="2"
                   AllowsTransparency="True" PopupAnimation="Fade"
                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                <Border MinWidth="{Binding ActualWidth, ElementName=Root}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Background="{StaticResource Head}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="6" Padding="4"
                        RenderOptions.ClearTypeHint="Enabled">
                    <ScrollViewer x:Name="DropDownScrollViewer" CanContentScroll="True"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </ScrollViewer>
                </Border>
            </Popup>

            <ToggleButton x:Name="Toggle" Grid.ColumnSpan="2" Style="{StaticResource ComboToggle}"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />

            <!-- A string becomes a TextBlock, which the TextBlock style above would
                 paint Ink at 13px; the empty style keeps the ComboBox's own look. -->
            <ContentPresenter x:Name="Face" Margin="{TemplateBinding Padding}" IsHitTestVisible="False"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}">
                <ContentPresenter.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    </Style>
                </ContentPresenter.Resources>
            </ContentPresenter>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Toggle" Property="BorderBrush" Value="{StaticResource Edge}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Toggle" Property="BorderBrush" Value="{StaticResource Pick}" />
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="Toggle" Property="BorderBrush" Value="{StaticResource Pick}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- The toggle stays behind the whole box; the text sits on top of it and
         stops short of the chevron, so a click on text is a click on text. -->
    <ControlTemplate x:Key="ComboEditableTemplate" TargetType="ComboBox">
        <Grid x:Name="Root" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>

            <Popup x:Name="PART_Popup" Grid.ColumnSpan="2" Placement="Bottom" VerticalOffset="2"
                   AllowsTransparency="True" PopupAnimation="Fade"
                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                <Border MinWidth="{Binding ActualWidth, ElementName=Root}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Background="{StaticResource Head}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="6" Padding="4"
                        RenderOptions.ClearTypeHint="Enabled">
                    <ScrollViewer x:Name="DropDownScrollViewer" CanContentScroll="True"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </ScrollViewer>
                </Border>
            </Popup>

            <ToggleButton x:Name="Toggle" Grid.ColumnSpan="2" Style="{StaticResource ComboToggle}"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />

            <!-- Fills its cell, padding included, so a click beside the text places
                 the caret instead of landing on the toggle behind it. -->
            <TextBox x:Name="PART_EditableTextBox" Style="{StaticResource ComboEditBox}"
                     Margin="1" Padding="9,2,0,2"
                     VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                     Foreground="{TemplateBinding Foreground}"
                     HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                     IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Toggle" Property="BorderBrush" Value="{StaticResource Edge}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Toggle" Property="BorderBrush" Value="{StaticResource Pick}" />
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="Toggle" Property="BorderBrush" Value="{StaticResource Pick}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource FaceUi}" />
        <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="{StaticResource Well}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template" Value="{StaticResource ComboTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsEditable" Value="True">
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template" Value="{StaticResource ComboEditableTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Branch names and environments: a git ref is closer to code than to
         prose, and a proportional face makes two similar refs hard to tell
         apart at a glance. -->
    <Style x:Key="Ref" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="FontFamily" Value="{StaticResource FaceMono}" />
        <Setter Property="Background" Value="{StaticResource Well}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Ink2}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" CornerRadius="4" SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock" />
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Lift}" />
                            <Setter Property="Foreground" Value="{StaticResource Ink}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Dim}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== checks, switches, segments ===================== -->

    <!-- Shown only when focus arrived from the keyboard, and drawn outside the
         control so it never looks like the checked state. -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="6" BorderThickness="2"
                            BorderBrush="{StaticResource Pick}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource FaceUi}" />
        <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" VerticalAlignment="Center"
                                Background="{StaticResource Well}" BorderBrush="{StaticResource Edge}"
                                BorderThickness="1">
                            <Grid>
                                <Path x:Name="Tick" Width="14" Height="14" Visibility="Collapsed"
                                      Data="M 3.5,7.2 L 6,9.7 L 10.6,4.3"
                                      Stroke="{StaticResource Ink}" StrokeThickness="1.75"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <Rectangle x:Name="Dash" Width="8" Height="2" RadiusX="1" RadiusY="1"
                                           Visibility="Collapsed" Fill="{StaticResource Ink}" />
                            </Grid>
                        </Border>
                        <ContentPresenter x:Name="Label" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="True">
                            <Setter TargetName="Label" Property="Margin" Value="8,0,0,0" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource PickFill}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Pick}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource PickFill}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Pick}" />
                            <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Faint}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource FaceUi}" />
        <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" StrokeThickness="1"
                                     Fill="{StaticResource Well}" Stroke="{StaticResource Edge}" />
                            <Ellipse x:Name="Dot" Width="6" Height="6" Visibility="Collapsed"
                                     Fill="{StaticResource Ink}" />
                        </Grid>
                        <ContentPresenter x:Name="Label" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="True">
                            <Setter TargetName="Label" Property="Margin" Value="8,0,0,0" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="{StaticResource PickFill}" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Pick}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Faint}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The label goes to the right of the track. -->
    <Style x:Key="Switch" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" VerticalAlignment="Center"
                                Background="{StaticResource Lift}" BorderBrush="{StaticResource Edge}"
                                BorderThickness="1">
                            <Ellipse x:Name="Knob" Width="14" Height="14" Margin="2,0,0,0"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Fill="{StaticResource Faint}">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                        <ContentPresenter x:Name="Label" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="True">
                            <Setter TargetName="Label" Property="Margin" Value="8,0,0,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Faint}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource PickFill}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Pick}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Ink}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="16" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One choice out of a few, laid side by side. -->
    <Style x:Key="Segment" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Faint}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Face" CornerRadius="4" BorderThickness="1" BorderBrush="Transparent"
                            SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
                        <Grid>
                            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="Underline" Height="2" Margin="8,0" CornerRadius="1"
                                    VerticalAlignment="Bottom" Visibility="Collapsed"
                                    Background="{StaticResource Pick}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource Row}" />
                            <Setter Property="Foreground" Value="{StaticResource Ink}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource Lift}" />
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Pick}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== rows ===================== -->

    <!-- A row you can click and that stays marked while it is the chosen one: the
         nav items, the note lists and the repositories. The button template paints
         Background itself, so hover and selection are set here on the style; a
         local Background would beat both. Selection is the row's own `Selected`
         property, so whatever it is bound to has to carry one. -->
    <Style x:Key="NavItem" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="6" Background="{TemplateBinding Background}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Row}" />
            </Trigger>
            <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter Property="Background" Value="{StaticResource Card}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== tips ===================== -->

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Lift}" />
        <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource FaceUi}" />
        <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border CornerRadius="4" SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <!-- Wraps a long string; the style also stands in for the TextBlock
                             style above, which would set the colour and size. -->
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== surfaces ===================== -->

    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="{StaticResource PadCard}" />
    </Style>

    <!-- ===================== drawer ===================== -->

    <!-- The header is drawn once, by the main window. Each form pins its own
         footer under its body, so the buttons sit in the same place whatever
         the form holds. -->
    <Style x:Key="DrawerHead" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Head}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="22,14" />
    </Style>

    <Style x:Key="DrawerFooter" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Head}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="22,14" />
    </Style>

    <!-- The x in the header: no chrome until it is pointed at or tabbed to. -->
    <Style x:Key="DrawerClose" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Faint}" />
        <Setter Property="FontSize" Value="{StaticResource TextTitle}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
    </Style>

</ResourceDictionary>
