<!--
    Every control style the chrome windows use, once.

    They used to live in each window separately, and four copies of a palette
    drift apart one edit at a time — measurably: `SectionHead` had three
    different margins, `TextBox` four different paddings, and the *primary*
    button was 14×7 at 13px in one window and 10×5 at 12px in another. None of
    that was a decision; it was four files being edited on different days.

    Merged per-window rather than into App.xaml, deliberately. The implicit
    styles here would otherwise also repaint the sticky note — which is yellow
    paper with a text area on it — and the speech bubble, which are desktop
    objects rather than app chrome and have their own look on purpose.

    Colours come from UI/Theme.xaml, which IS application-wide.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===================== the scales =====================

         Spacing is a 4px grid with 6 and 10 allowed as half-steps, because a
         one-line control centred in a 4-grid box lands on a half-step often
         enough that forbidding them just produces 8s that look like 6s.

         These are the vocabulary. Where a style below can carry the spacing it
         does, so the value is applied once rather than typed at each use site —
         that, rather than the naming, is what actually keeps it consistent. -->

    <!-- Thicknesses rather than a scale of Doubles, because XAML cannot compose
         a Thickness out of Doubles: a `Space2` would be a number nothing could
         actually be spaced by. Only the values that repeat enough to be worth
         one definition are here — a name for a one-off gap is harder to read
         than the number it replaces, not easier. -->
    <Thickness x:Key="GapAfter">0,0,8,0</Thickness>
    <Thickness x:Key="GapBefore">8,0,0,0</Thickness>
    <Thickness x:Key="GapBelow">0,0,0,8</Thickness>

    <!-- Type: four sizes, no halves. A half-pixel face rounds unpredictably
         from line to line under TextFormattingMode="Display", which reads as
         badly-set text and is very hard to place if you don't know it. -->
    <sys:Double x:Key="TextLabel">11</sys:Double>
    <sys:Double x:Key="TextSmall">12</sys:Double>
    <sys:Double x:Key="TextBody">13</sys:Double>
    <sys:Double x:Key="TextTitle">15</sys:Double>

    <sys:String x:Key="FaceUi">Segoe UI</sys:String>
    <sys:String x:Key="FaceMono">Consolas</sys:String>

    <!-- Shared paddings, so a card in one window is a card in the next. -->
    <Thickness x:Key="PadCard">14,12</Thickness>
    <Thickness x:Key="PadField">8,6</Thickness>
    <Thickness x:Key="GapSection">0,16,0,8</Thickness>
    <Thickness x:Key="GapButton">0,0,6,0</Thickness>

    <!-- ===================== text ===================== -->

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource FaceUi}" />
        <Setter Property="FontSize" Value="{StaticResource TextBody}" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!-- Secondary text inside a row or a list. No wrapping: these sit in rows
         of a fixed height, and a second line there changes the row's height
         rather than the text's. Prose that should wrap uses Prose below. -->
    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Faint}" />
        <Setter Property="FontFamily" Value="{StaticResource FaceUi}" />
        <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!-- The same, for explanation under a field or in a card. -->
    <Style x:Key="Prose" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Counts, times and shas line up in columns, so they get tabular figures. -->
    <Style x:Key="Figure" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Faint}" />
        <Setter Property="FontFamily" Value="{StaticResource FaceMono}" />
        <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
    </Style>

    <!-- No margin: the caller places it, because a pinned toolbar and a
         scrolling form want different space above a heading. SectionTop is the
         stacked-form version. -->
    <Style x:Key="SectionHead" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Faint}" />
        <Setter Property="FontFamily" Value="{StaticResource FaceUi}" />
        <Setter Property="FontSize" Value="{StaticResource TextLabel}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SectionTop" TargetType="TextBlock" BasedOn="{StaticResource SectionHead}">
        <Setter Property="Margin" Value="{StaticResource GapSection}" />
    </Style>

    <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource FaceUi}" />
        <Setter Property="FontSize" Value="{StaticResource TextTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ===================== buttons ===================== -->

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="{StaticResource Line}" />
        <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontFamily" Value="{StaticResource FaceUi}" />
        <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="5"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Edge}" />
                        </Trigger>

                        <!-- Pressed reads as a press, rather than as hover that
                             happens to be under the finger. -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Lift}" />
                        </Trigger>

                        <!-- Keyboard users need to see where they are, and the
                             default WPF dotted rectangle is invisible on this
                             background. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Pick}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One primary action per screen. Its fill is a step darker than the
         accent so the border still reads as an edge — they were collapsed onto
         the same value at one point, which flattened it into a blue slab. -->
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource PickFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource Pick}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontSize" Value="{StaticResource TextBody}" />
    </Style>

    <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="Foreground" Value="{StaticResource Faint}" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="FontSize" Value="{StaticResource TextLabel}" />
    </Style>

    <!-- Destructive, and visually separated from the action beside it. -->
    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource BadTint}" />
        <Setter Property="BorderBrush" Value="{StaticResource BadEdge}" />
        <Setter Property="Foreground" Value="{StaticResource BadInk}" />
    </Style>

    <!-- ===================== fields ===================== -->

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource FaceUi}" />
        <Setter Property="FontSize" Value="{StaticResource TextBody}" />
        <Setter Property="Padding" Value="{StaticResource PadField}" />
        <Setter Property="Background" Value="{StaticResource Well}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- The one that sits inside a list row and has to stay row-height. -->
    <Style x:Key="Inline" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
        <Setter Property="Padding" Value="4,3" />
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource FaceUi}" />
        <Setter Property="FontSize" Value="{StaticResource TextBody}" />
        <Setter Property="Padding" Value="{StaticResource PadField}" />
        <Setter Property="Background" Value="{StaticResource Well}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource FaceUi}" />
        <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
    </Style>

    <!-- Branch names and environments: a git ref is closer to code than to
         prose, and a proportional face makes two similar refs hard to tell
         apart at a glance. -->
    <Style x:Key="Ref" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="FontFamily" Value="{StaticResource FaceMono}" />
        <Setter Property="Background" Value="{StaticResource Well}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource FaceUi}" />
        <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource FaceUi}" />
        <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- ===================== surfaces ===================== -->

    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="{StaticResource PadCard}" />
    </Style>

</ResourceDictionary>
