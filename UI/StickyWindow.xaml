<Window x:Class="CoderMascot.UI.StickyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Note"
        Width="240" Height="200"
        MinWidth="160" MinHeight="120"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Header buttons: no chrome until you're on them, so the note reads as
             paper rather than as a dialog. -->
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="4" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#33000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu x:Name="Menu">
            <MenuItem Header="New note" Click="OnNewNote" />
            <MenuItem x:Name="MenuColours" Header="Colour" />
            <Separator />
            <MenuItem Header="Mark it done" Click="OnDone" />
            <MenuItem Header="Put it back in the list" Click="OnClose" />
            <MenuItem Header="Delete this note…" Click="OnDelete" />
        </ContextMenu>
    </Window.ContextMenu>

    <Border x:Name="Paper" CornerRadius="5" Background="#FDE68A"
            BorderBrush="#22000000" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.35" Color="#000000" />
        </Border.Effect>

        <DockPanel>
            <Border x:Name="Header" DockPanel.Dock="Top" Height="26"
                    Background="#FBBF24" CornerRadius="4,4,0,0"
                    MouseLeftButtonDown="OnHeaderDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource Chip}" Click="OnCycleColour"
                            ToolTip="Change the colour" Margin="3,0,0,0">
                        <Ellipse x:Name="Swatch" Width="11" Height="11" Fill="#FDE68A"
                                 Stroke="#55000000" StrokeThickness="1" />
                    </Button>

                    <!-- The list this note is filed under, so a wall of them on the
                         desktop still says which is which. -->
                    <TextBlock x:Name="GroupLabel" Grid.Column="1" VerticalAlignment="Center"
                               Margin="6,0" FontFamily="Segoe UI" FontSize="10.5"
                               Opacity="0.75" TextTrimming="CharacterEllipsis"
                               IsHitTestVisible="False" />

                    <Button Grid.Column="2" Style="{StaticResource Chip}" Content="✓"
                            Click="OnDone" ToolTip="Done with it" />
                    <Button Grid.Column="3" Style="{StaticResource Chip}" Content="✕"
                            Click="OnClose" ToolTip="Put it back in the list" Margin="0,0,3,0" />
                </Grid>
            </Border>

            <TextBox x:Name="Body"
                     Background="Transparent" BorderThickness="0"
                     AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Segoe UI" FontSize="13"
                     Padding="9,7,9,14"
                     TextChanged="OnBodyChanged" />
        </DockPanel>
    </Border>
</Window>
