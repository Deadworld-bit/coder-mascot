<Window x:Class="CoderMascot.UI.MascotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Coder Mascot"
        Width="120" Height="120"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Alarm: quick shake. Applied to the whole window content. -->
        <Storyboard x:Key="ShakeStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="Shift"
                             Storyboard.TargetProperty="X"
                             From="-3" To="3" Duration="0:0:0.07" />
        </Storyboard>

        <!-- Status light on the badge. -->
        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="Bulb"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.25" Duration="0:0:0.7" />
        </Storyboard>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="MenuStatus" Header="Checking…" IsEnabled="False" />
            <MenuItem x:Name="MenuSessionWatch" Header="Session watch: not set up"
                      Visibility="Collapsed" Click="OnSessionWatchHelp" />
            <Separator />
            <!-- Same thing a left-click does, for when the mascot is
                 click-through and the mouse passes straight through it. -->
            <MenuItem x:Name="MenuDismiss" Header="I know about this — stop telling me"
                      IsEnabled="False" Click="OnDismiss" />
            <MenuItem Header="Messages">
                <MenuItem x:Name="MenuAlertsAll" Header="Show everything"
                          IsCheckable="True" IsChecked="True" Click="OnAlertsAll" />
                <MenuItem x:Name="MenuAlertsQuiet" Header="Quiet — no pop-ups, still comes to get you"
                          IsCheckable="True" Click="OnAlertsQuiet" />
                <MenuItem x:Name="MenuAlertsOff" Header="Off — badge colour only"
                          IsCheckable="True" Click="OnAlertsOff" />
            </MenuItem>
            <Separator />
            <MenuItem x:Name="MenuDashboard" Header="Dashboard…" Click="OnShowDashboard"
                      FontWeight="SemiBold" />
            <MenuItem x:Name="MenuBranches" Header="Branches…" Click="OnShowBranches" />
            <MenuItem x:Name="MenuNewNote" Header="New sticky note" Click="OnNewNote" />
            <MenuItem x:Name="MenuCheckNow" Header="Check now" Click="OnCheckNow" />
            <MenuItem x:Name="MenuOpenDashboard" Header="Open Coder dashboard" Click="OnOpenDashboard" />
            <MenuItem x:Name="MenuSetup" Header="Connect to Coder…" Click="OnShowSetup" />
            <MenuItem x:Name="MenuEditConfig" Header="Edit config… (restart to apply)" Click="OnEditConfig" />
            <Separator />
            <MenuItem x:Name="MenuPatrol" Header="Walk around the edges" IsCheckable="True" IsChecked="True"
                      Click="OnTogglePatrol" />
            <MenuItem x:Name="MenuClickThrough" Header="Click-through" IsCheckable="True"
                      Click="OnToggleClickThrough" />
            <MenuItem x:Name="MenuStartWithWindows" Header="Start with Windows" IsCheckable="True"
                      Click="OnToggleStartup" />
            <Separator />
            <MenuItem Header="Quit" Click="OnQuit" />
        </ContextMenu>
    </Window.ContextMenu>

    <Canvas x:Name="Root" Width="120" Height="120">
        <Canvas.RenderTransform>
            <TranslateTransform x:Name="Shift" X="0" Y="0" />
        </Canvas.RenderTransform>

        <!-- The character. Each screen edge has its own artwork — walking,
             hanging, climbing — so the only transform is the mirror that turns
             it to face the other way. -->
        <Image x:Name="Sprite"
               Canvas.Left="12" Canvas.Top="12"
               Width="96" Height="96"
               RenderOptions.BitmapScalingMode="HighQuality">
            <Image.RenderTransform>
                <ScaleTransform x:Name="Flip" ScaleX="1" ScaleY="1" CenterX="48" CenterY="48" />
            </Image.RenderTransform>
        </Image>

        <!-- State badge. Deliberately outside the sprite's transform so it
             never mirrors with the character. Starts grey: nothing has been
             polled yet, and green would be a lie. -->
        <Ellipse x:Name="Bulb"
                 Canvas.Left="98" Canvas.Top="2"
                 Width="18" Height="18"
                 Fill="#64748B"
                 Stroke="#59000000" StrokeThickness="1.5" />
    </Canvas>
</Window>
