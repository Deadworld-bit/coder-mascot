<Window x:Class="CoderMascot.UI.MascotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Coder Mascot"
        Width="120" Height="120"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        ContextMenuOpening="OnContextMenuOpening">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/Menus.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Alarm: quick shake. Applied to the whole window content. -->
            <Storyboard x:Key="ShakeStoryboard" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="Shift"
                                 Storyboard.TargetProperty="X"
                                 From="-3" To="3" Duration="0:0:0.07" />
            </Storyboard>

            <!-- Status light on the badge. -->
            <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="Bulb"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1.0" To="0.25" Duration="0:0:0.7" />
            </Storyboard>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Empty on purpose: rebuilt from AppMenu each time it is about to open. It
         stays here so the implicit styles in Menus.xaml apply to what is added. -->
    <Window.ContextMenu>
        <ContextMenu />
    </Window.ContextMenu>

    <Canvas x:Name="Root" Width="120" Height="120">
        <Canvas.RenderTransform>
            <TranslateTransform x:Name="Shift" X="0" Y="0" />
        </Canvas.RenderTransform>

        <!-- The character. Each screen edge has its own artwork — walking,
             hanging, climbing — so the only transform is the mirror that turns
             it to face the other way. -->
        <Image x:Name="Sprite"
               Canvas.Left="12" Canvas.Top="12"
               Width="96" Height="96"
               RenderOptions.BitmapScalingMode="HighQuality">
            <Image.RenderTransform>
                <ScaleTransform x:Name="Flip" ScaleX="1" ScaleY="1" CenterX="48" CenterY="48" />
            </Image.RenderTransform>
        </Image>

        <!-- State badge. Deliberately outside the sprite's transform so it
             never mirrors with the character. Starts grey: nothing has been
             polled yet, and green would be a lie. -->
        <Ellipse x:Name="Bulb"
                 Canvas.Left="98" Canvas.Top="2"
                 Width="18" Height="18"
                 Fill="#64748B"
                 Stroke="#59000000" StrokeThickness="1.5" />
    </Canvas>
</Window>
